---
import { Github, Zap, ArrowUpRight, FileText, X, CheckCircle2, ShoppingBag, BarChart3, CalendarCheck, ShieldCheck, Network, Cloud } from 'lucide-astro';

interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  category?: string;
  role: "Full-Stack" | "DevOps/SRE" | "Hybrid";
  description: string;
  impact: string;
  stack: string[];
  github?: string;
  demo?: string;
  featured?: boolean;
  order?: number;
}

const { id, title, subtitle, category, role, description, impact, stack, github, demo, featured = false, order = 1 } = Astro.props;

// Category icon & visual gradient presets
const categoryIcons = [
  ShoppingBag,
  BarChart3,
  CalendarCheck,
  ShieldCheck,
  Network,
  Cloud,
];

const CategoryIcon = categoryIcons[(order - 1) % categoryIcons.length] || ShoppingBag;

const gradientThemes = [
  "from-amber-500/15 via-orange-500/10 to-yellow-500/5 border-amber-500/20 text-amber-500",
  "from-blue-500/15 via-indigo-500/10 to-violet-500/5 border-blue-500/20 text-blue-500",
  "from-cyan-500/15 via-teal-500/10 to-emerald-500/5 border-cyan-500/20 text-cyan-500",
  "from-rose-500/15 via-pink-500/10 to-purple-500/5 border-rose-500/20 text-rose-500",
  "from-violet-500/15 via-purple-500/10 to-indigo-500/5 border-violet-500/20 text-violet-500",
  "from-emerald-500/15 via-teal-500/10 to-cyan-500/5 border-emerald-500/20 text-emerald-500",
];

const currentGradient = gradientThemes[(order - 1) % gradientThemes.length];

const modalId = `project-modal-${order}-${Math.random().toString(36).substring(2, 7)}`;
---

<div
  class="group relative rounded-3xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#0f1117] flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:border-slate-400 dark:hover:border-white/25 overflow-hidden"
  data-role={role}
>
  <!-- Card Header Visual Bar (App Mockup Aesthetic) -->
  <div class={`p-5 pb-4 bg-gradient-to-br ${currentGradient} border-b border-slate-100 dark:border-white/5`}>
    <div class="flex items-center justify-between gap-3 mb-3">
      <!-- 3 Minimalist Mac-style Window Dots -->
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-red-400/80 inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400/80 inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/80 inline-block"></span>
      </div>

      <!-- Category Pill -->
      <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-white dark:bg-white/10 text-slate-850 dark:text-slate-200 border border-slate-200/60 dark:border-white/10 shadow-sm">
        <CategoryIcon class="w-3 h-3 text-current" />
        <span>{category || role}</span>
      </span>
    </div>

    <!-- Title and Subtitle -->
    <div class="mt-2">
      <h3 class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-snug group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
        {title}
      </h3>
      {subtitle && (
        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-1">
          {subtitle}
        </p>
      )}
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-6 flex flex-col justify-between flex-grow space-y-5">
    <div>
      <!-- Human-Friendly Description -->
      <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        {description}
      </p>

      <!-- Real Business Impact Badge -->
      <div class="mt-4 p-3 rounded-2xl bg-emerald-500/10 dark:bg-emerald-950/30 border border-emerald-500/20 text-emerald-850 dark:text-emerald-300 text-xs flex items-start gap-2.5">
        <Zap class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
        <div class="leading-relaxed">
          <span class="font-bold text-slate-800 dark:text-slate-200 block sm:inline">Manfaat Nyata: </span>
          <span class="font-medium">{impact}</span>
        </div>
      </div>
    </div>

    <!-- Tech Stack Chips -->
    <div class="space-y-4 pt-3 border-t border-slate-100 dark:border-white/5">
      <div class="flex flex-wrap items-center gap-1.5">
        {stack.map((item) => (
          <span class="px-2.5 py-1 rounded-lg text-[11px] font-medium bg-slate-100 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 text-slate-700 dark:text-slate-300">
            {item}
          </span>
        ))}
      </div>

      <!-- Action Buttons (View Details, Live Demo, GitHub) -->
      <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
        <button
          type="button"
          onclick={`document.getElementById('${modalId}').showModal()`}
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-950 text-xs font-bold hover:opacity-90 transition-all cursor-pointer shadow-sm active:scale-95"
        >
          <FileText class="w-3.5 h-3.5" />
          <span data-i18n="projects.btnWriteup">Lihat Detail</span>
        </button>

        <div class="flex items-center gap-1.5">
          {github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/10 transition-colors shadow-sm"
              title="Lihat Kode di GitHub"
              aria-label={`${title} GitHub`}
            >
              <Github class="w-4 h-4" />
            </a>
          )}
          {demo && (
            <a
              href={demo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 px-3 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-slate-700 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400 hover:bg-slate-100 dark:hover:bg-white/10 text-xs font-semibold transition-colors shadow-sm"
              title="Coba Langsung"
              aria-label={`${title} Live Demo`}
            >
              <span data-i18n="projects.btnDemo">Demo</span>
              <ArrowUpRight class="w-3.5 h-3.5" />
            </a>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Detail Modal (User-Friendly for Non-IT) -->
  <dialog
    id={modalId}
    class="backdrop:bg-slate-950/80 backdrop:backdrop-blur-md rounded-3xl border border-slate-200 dark:border-white/15 bg-white dark:bg-[#0c0e14] text-slate-900 dark:text-slate-100 p-0 w-full max-w-2xl shadow-2xl overflow-hidden m-auto"
  >
    <div class="p-6 sm:p-8 space-y-6 max-h-[85vh] overflow-y-auto">
      <!-- Modal Header -->
      <div class="flex items-start justify-between gap-4 border-b border-slate-200 dark:border-white/10 pb-5">
        <div>
          <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-slate-100 dark:bg-white/10 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-white/10 mb-2">
            <CategoryIcon class="w-3.5 h-3.5" />
            <span>{category || role}</span>
          </span>
          <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            {title}
          </h3>
          {subtitle && (
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">
              {subtitle}
            </p>
          )}
        </div>
        <button
          type="button"
          onclick={`document.getElementById('${modalId}').close()`}
          class="p-2 rounded-full border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-white/5 text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer shrink-0"
          aria-label="Tutup Jendela"
        >
          <X class="w-4 h-4" />
        </button>
      </div>

      <!-- Human-Friendly Breakdown -->
      <div class="space-y-4">
        <!-- 1. The Challenge -->
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-white/5 border border-slate-200/80 dark:border-white/10">
          <div class="flex items-center gap-2 text-slate-900 dark:text-white font-bold text-sm mb-1.5">
            <span class="w-5 h-5 rounded-full bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xs">🎯</span>
            <span>Tantangan & Kebutuhan Bisnis:</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Banyak pemilik usaha menghadapi kendala sistem lambat, pencatatan manual yang rawan keliru, atau proses checkout yang rumit sehingga calon pembeli batal bertransaksi.
          </p>
        </div>

        <!-- 2. The Solution -->
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-white/5 border border-slate-200/80 dark:border-white/10">
          <div class="flex items-center gap-2 text-slate-900 dark:text-white font-bold text-sm mb-1.5">
            <span class="w-5 h-5 rounded-full bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 flex items-center justify-center text-xs">💡</span>
            <span>Solusi Yang Dibuat:</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            {description}
          </p>
        </div>

        <!-- 3. Measurable Impact -->
        <div class="p-4 rounded-2xl bg-emerald-500/10 dark:bg-emerald-950/30 border border-emerald-500/25">
          <div class="flex items-center gap-2 text-emerald-850 dark:text-emerald-300 font-bold text-sm mb-1.5">
            <CheckCircle2 class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
            <span>Hasil Nyata untuk Bisnis:</span>
          </div>
          <p class="text-xs sm:text-sm text-emerald-800 dark:text-emerald-200 font-medium leading-relaxed">
            {impact}
          </p>
        </div>

        <!-- 4. Technical Specs for Developers/HR -->
        <div class="p-4 rounded-2xl bg-slate-100/70 dark:bg-white/[0.03] border border-slate-200/80 dark:border-white/5">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-2">
            Teknologi & Framework yang Digunakan:
          </span>
          <div class="flex flex-wrap gap-1.5">
            {stack.map((item) => (
              <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-white dark:bg-white/10 border border-slate-200 dark:border-white/10 text-slate-800 dark:text-slate-200">
                {item}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-200 dark:border-white/10">
        <button
          type="button"
          onclick={`document.getElementById('${modalId}').close()`}
          class="px-4 py-2 rounded-xl border border-slate-200 dark:border-white/10 text-xs font-semibold hover:bg-slate-100 dark:hover:bg-white/5 transition-colors cursor-pointer"
        >
          Tutup
        </button>

        <div class="flex items-center gap-2">
          {github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-xs font-bold hover:bg-slate-100 dark:hover:bg-white/10 transition-colors"
            >
              <Github class="w-3.5 h-3.5" />
              <span>GitHub</span>
            </a>
          )}
          {demo && (
            <a
              href={demo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-950 text-xs font-bold hover:opacity-90 transition-all"
            >
              <span>Buka Demo</span>
              <ArrowUpRight class="w-3.5 h-3.5" />
            </a>
          )}
        </div>
      </div>
    </div>
  </dialog>
</div>
