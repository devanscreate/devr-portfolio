---
import { Github, Zap, ArrowUpRight, FileText, X, CheckCircle2, ShoppingBag, BarChart3, CalendarCheck, ShieldCheck, Network, Cloud, ChevronLeft, ChevronRight, Eye, Sparkles } from 'lucide-astro';

interface ImageItem {
  url: string;
  title: string;
  caption?: string;
}

interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  category?: string;
  role: "Full-Stack" | "DevOps/SRE" | "Hybrid";
  description: string;
  impact: string;
  stack: string[];
  github?: string;
  demo?: string;
  featured?: boolean;
  order?: number;
  images?: ImageItem[];
}

const { id, title, subtitle, category, role, description, impact, stack, github, demo, featured = false, order = 1, images } = Astro.props;

// Category icon & visual gradient presets
const categoryIcons = [
  ShoppingBag,
  BarChart3,
  CalendarCheck,
  ShieldCheck,
  Network,
  Cloud,
];

const CategoryIcon = categoryIcons[(order - 1) % categoryIcons.length] || ShoppingBag;

const defaultImages: ImageItem[] = [
  {
    url: `/images/projects/project-${order}-1.jpg`,
    title: "1. Tampilan Utama / Beranda",
    caption: "Tampilan beranda dan navigasi utama program dengan antarmuka yang bersih dan intuitif.",
  },
  {
    url: `/images/projects/project-${order}-2.jpg`,
    title: "2. Fitur Inti & Alur Kerja",
    caption: "Proses transaksi dan interaksi utama pengguna yang dirancang cepat dan tanpa kendala.",
  },
  {
    url: `/images/projects/project-${order}-3.jpg`,
    title: "3. Panel Manajemen / Analitik",
    caption: "Dashboard pemantauan dan pengelolaan data yang memudahkan tim mengontrol operasional.",
  },
];

const projectImages = images && images.length >= 3 ? images : defaultImages;
const modalId = `project-modal-${order}-${Math.random().toString(36).substring(2, 7)}`;
---

<div
  class="group relative rounded-3xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#0f1117] flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:border-slate-400 dark:hover:border-white/25 overflow-hidden"
  data-role={role}
>
  <!-- Card Header Screenshot Preview (Clickable to open 3 Screenshots Modal) -->
  <div class="p-4 sm:p-5 pb-0">
    <div
      role="button"
      tabindex="0"
      onclick={`document.getElementById('${modalId}').showModal()`}
      onkeydown={`(e) => { if (e.key === 'Enter' || e.key === ' ') document.getElementById('${modalId}').showModal() }`}
      class="group/img relative rounded-2xl overflow-hidden border border-slate-200/90 dark:border-white/10 aspect-[16/10] bg-slate-950/10 cursor-pointer block select-none shadow-sm"
      title="Klik untuk melihat 3 tampilan screenshot program"
    >
      <!-- Top Window Mini Bar -->
      <div class="absolute top-0 inset-x-0 z-10 px-3 py-2 bg-slate-900/70 backdrop-blur-md flex items-center justify-between border-b border-white/10">
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-red-400/90 inline-block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400/90 inline-block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/90 inline-block"></span>
        </div>
        <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-white/15 text-white text-[10px] font-bold uppercase tracking-wider backdrop-blur-sm">
          <Eye class="w-2.5 h-2.5 text-cyan-400" />
          <span>3 Screenshot</span>
        </div>
      </div>

      <!-- Screenshot Preview Image -->
      <img
        src={projectImages[0].url}
        alt={`${title} - Preview`}
        class="w-full h-full object-cover object-top transition-transform duration-500 group-hover/img:scale-105"
        loading="lazy"
      />

      <!-- Interactive Hover Overlay (Direct Visual Invitation for HRD) -->
      <div class="absolute inset-0 z-20 bg-slate-950/70 backdrop-blur-[2px] opacity-0 group-hover/img:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-4 text-center">
        <div class="w-12 h-12 rounded-full bg-white text-slate-950 flex items-center justify-center shadow-xl mb-2.5 group-hover/img:scale-110 transition-transform">
          <Eye class="w-6 h-6 text-slate-950" />
        </div>
        <span class="text-white font-extrabold text-sm tracking-tight block">
          Klik untuk Melihat 3 Tampilan
        </span>
        <span class="text-cyan-300 text-xs font-medium mt-0.5 block">
          Tampilan utama &bull; Fitur &bull; Panel Admin
        </span>
      </div>
    </div>
  </div>

  <!-- Card Body Info -->
  <div class="p-5 sm:p-6 flex flex-col justify-between flex-grow space-y-4">
    <div>
      <!-- Category Badge & Role -->
      <div class="flex items-center justify-between gap-2 mb-2">
        <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-white/10 text-slate-800 dark:text-slate-200 border border-slate-200/80 dark:border-white/10">
          <CategoryIcon class="w-3 h-3 text-cyan-500" />
          <span>{category || role}</span>
        </span>
        <span class="text-[10px] font-mono font-bold text-slate-500 uppercase">
          {role}
        </span>
      </div>

      <!-- Title & Subtitle -->
      <h3
        onclick={`document.getElementById('${modalId}').showModal()`}
        class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-snug hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors cursor-pointer"
      >
        {title}
      </h3>
      {subtitle && (
        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-1">
          {subtitle}
        </p>
      )}

      <!-- Description -->
      <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        {description}
      </p>

      <!-- Business Impact Pill -->
      <div class="mt-3.5 p-3 rounded-2xl bg-emerald-500/10 dark:bg-emerald-950/30 border border-emerald-500/20 text-emerald-850 dark:text-emerald-300 text-xs flex items-start gap-2">
        <Zap class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
        <div class="leading-relaxed">
          <span class="font-bold text-slate-800 dark:text-slate-200 block sm:inline">Manfaat Nyata: </span>
          <span class="font-medium">{impact}</span>
        </div>
      </div>
    </div>

    <!-- Tech Stack & Action Bar -->
    <div class="space-y-3.5 pt-3 border-t border-slate-100 dark:border-white/5">
      <div class="flex flex-wrap items-center gap-1.5">
        {stack.map((item) => (
          <span class="px-2 py-0.5 rounded-lg text-[11px] font-medium bg-slate-100 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 text-slate-700 dark:text-slate-300">
            {item}
          </span>
        ))}
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
        <button
          type="button"
          onclick={`document.getElementById('${modalId}').showModal()`}
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-950 text-xs font-bold hover:opacity-90 transition-all cursor-pointer shadow-sm active:scale-95"
        >
          <Eye class="w-3.5 h-3.5 text-cyan-400 dark:text-cyan-600" />
          <span>Lihat 3 Tampilan</span>
        </button>

        <div class="flex items-center gap-1.5">
          {github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/10 transition-colors shadow-sm"
              title="Lihat Kode di GitHub"
              aria-label={`${title} GitHub`}
            >
              <Github class="w-4 h-4" />
            </a>
          )}
          {demo && (
            <a
              href={demo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 px-3 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-slate-700 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400 hover:bg-slate-100 dark:hover:bg-white/10 text-xs font-semibold transition-colors shadow-sm"
              title="Buka Demo Langsung"
              aria-label={`${title} Live Demo`}
            >
              <span>Demo</span>
              <ArrowUpRight class="w-3.5 h-3.5" />
            </a>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- ================= INTERACTIVE 3-SCREENSHOT MODAL GALLERY ================= -->
  <dialog
    id={modalId}
    class="backdrop:bg-slate-950/85 backdrop:backdrop-blur-md rounded-3xl border border-slate-200 dark:border-white/15 bg-white dark:bg-[#0c0e14] text-slate-900 dark:text-slate-100 p-0 w-full max-w-4xl shadow-2xl overflow-hidden m-auto"
  >
    <div class="p-5 sm:p-7 space-y-6 max-h-[90vh] overflow-y-auto">
      
      <!-- Modal Header -->
      <div class="flex items-start justify-between gap-4 border-b border-slate-200 dark:border-white/10 pb-4">
        <div>
          <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-white/10 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-white/10 mb-2">
            <CategoryIcon class="w-3.5 h-3.5 text-cyan-500" />
            <span>{category || role}</span>
          </span>
          <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
            {title}
          </h3>
          {subtitle && (
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">
              {subtitle}
            </p>
          )}
        </div>
        <button
          type="button"
          onclick={`document.getElementById('${modalId}').close()`}
          class="p-2 rounded-full border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-white/5 text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer shrink-0"
          aria-label="Tutup Jendela"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <!-- MAIN 3-SCREENSHOT SHOWCASE SECTION -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-extrabold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <Sparkles class="w-3.5 h-3.5 text-cyan-500" />
            <span>Tampilan Inti Program (3 Screenshot)</span>
          </span>
          <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400">
            Klik thumbnail di bawah untuk berpindah tampilan
          </span>
        </div>

        <!-- Main Screenshot Frame with Prev/Next Navigation Arrows -->
        <div class="relative rounded-2xl overflow-hidden border border-slate-200 dark:border-white/15 aspect-[16/10] bg-slate-950 shadow-lg group/stage">
          <img
            id={`main-img-${modalId}`}
            src={projectImages[0].url}
            alt={projectImages[0].title}
            class="w-full h-full object-cover object-top transition-all duration-300 select-none"
          />

          <!-- Left Prev Button -->
          <button
            type="button"
            id={`prev-btn-${modalId}`}
            class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/80 hover:bg-slate-900 text-white backdrop-blur-md flex items-center justify-center border border-white/20 shadow-xl transition-all cursor-pointer opacity-80 hover:opacity-100 hover:scale-105 active:scale-95"
            title="Tampilan Sebelumnya"
          >
            <ChevronLeft class="w-5 h-5" />
          </button>

          <!-- Right Next Button -->
          <button
            type="button"
            id={`next-btn-${modalId}`}
            class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/80 hover:bg-slate-900 text-white backdrop-blur-md flex items-center justify-center border border-white/20 shadow-xl transition-all cursor-pointer opacity-80 hover:opacity-100 hover:scale-105 active:scale-95"
            title="Tampilan Berikutnya"
          >
            <ChevronRight class="w-5 h-5" />
          </button>

          <!-- View Counter Badge Overlay -->
          <div class="absolute bottom-3 right-3 px-3 py-1 rounded-full bg-slate-950/80 backdrop-blur-md text-white text-xs font-mono font-bold border border-white/20 shadow-md">
            <span id={`counter-${modalId}`}>1</span> / 3
          </div>
        </div>

        <!-- Active Screenshot Title & Caption -->
        <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10">
          <h4 id={`caption-title-${modalId}`} class="text-sm font-extrabold text-slate-900 dark:text-white">
            {projectImages[0].title}
          </h4>
          <p id={`caption-text-${modalId}`} class="text-xs text-slate-600 dark:text-slate-400 mt-1 leading-relaxed">
            {projectImages[0].caption || "Tampilan detail komponen dan alur penggunaan aplikasi."}
          </p>
        </div>

        <!-- 3 Interactive Clickable Thumbnails Grid -->
        <div class="grid grid-cols-3 gap-2.5 sm:gap-3.5 pt-1">
          {projectImages.map((img, idx) => (
            <button
              type="button"
              data-idx={idx}
              class={`thumb-btn-${modalId} text-left p-1.5 sm:p-2 rounded-xl border transition-all cursor-pointer flex flex-col gap-1.5 ${
                idx === 0
                  ? 'border-cyan-500 bg-cyan-500/10 ring-2 ring-cyan-500/40 shadow-sm'
                  : 'border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 hover:border-slate-400 dark:hover:border-white/30'
              }`}
            >
              <div class="aspect-[16/10] rounded-lg overflow-hidden bg-slate-900/20">
                <img
                  src={img.url}
                  alt={img.title}
                  class="w-full h-full object-cover object-top"
                  loading="lazy"
                />
              </div>
              <span class="text-[11px] font-bold text-slate-800 dark:text-slate-200 truncate block">
                {img.title}
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- Human-Friendly Business Case Details -->
      <div class="space-y-3.5 pt-4 border-t border-slate-200 dark:border-white/10">
        <!-- 1. The Challenge -->
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-white/5 border border-slate-200/80 dark:border-white/10">
          <div class="flex items-center gap-2 text-slate-900 dark:text-white font-bold text-sm mb-1">
            <span class="w-5 h-5 rounded-full bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xs">🎯</span>
            <span>Tantangan Bisnis:</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Kebutuhan akan sistem yang responsif, minim error, dan mudah digunakan pelanggan maupun staf kantor tanpa memerlukan buku manual yang rumit.
          </p>
        </div>

        <!-- 2. The Solution -->
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-white/5 border border-slate-200/80 dark:border-white/10">
          <div class="flex items-center gap-2 text-slate-900 dark:text-white font-bold text-sm mb-1">
            <span class="w-5 h-5 rounded-full bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 flex items-center justify-center text-xs">💡</span>
            <span>Solusi Yang Dibangun:</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            {description}
          </p>
        </div>

        <!-- 3. Measurable Impact -->
        <div class="p-4 rounded-2xl bg-emerald-500/10 dark:bg-emerald-950/30 border border-emerald-500/25">
          <div class="flex items-center gap-2 text-emerald-850 dark:text-emerald-300 font-bold text-sm mb-1">
            <CheckCircle2 class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
            <span>Hasil Nyata untuk Bisnis:</span>
          </div>
          <p class="text-xs sm:text-sm text-emerald-800 dark:text-emerald-200 font-medium leading-relaxed">
            {impact}
          </p>
        </div>

        <!-- 4. Technical Specs -->
        <div class="p-4 rounded-2xl bg-slate-100/70 dark:bg-white/[0.03] border border-slate-200/80 dark:border-white/5">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-2">
            Teknologi & Framework:
          </span>
          <div class="flex flex-wrap gap-1.5">
            {stack.map((item) => (
              <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-white dark:bg-white/10 border border-slate-200 dark:border-white/10 text-slate-800 dark:text-slate-200">
                {item}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Modal Footer Action Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-200 dark:border-white/10">
        <button
          type="button"
          onclick={`document.getElementById('${modalId}').close()`}
          class="px-4 py-2 rounded-xl border border-slate-200 dark:border-white/10 text-xs font-bold hover:bg-slate-100 dark:hover:bg-white/5 transition-colors cursor-pointer"
        >
          Tutup
        </button>

        <div class="flex items-center gap-2">
          {github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-xs font-bold hover:bg-slate-100 dark:hover:bg-white/10 transition-colors"
            >
              <Github class="w-3.5 h-3.5" />
              <span>Kode GitHub</span>
            </a>
          )}
          {demo && (
            <a
              href={demo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-950 text-xs font-bold hover:opacity-90 transition-all shadow-md"
            >
              <span>Buka Demo</span>
              <ArrowUpRight class="w-3.5 h-3.5" />
            </a>
          )}
        </div>
      </div>

    </div>
  </dialog>

  <!-- Interactive Gallery Script for this Modal -->
  <script is:inline define:vars={{ modalId, projectImages }}>
    (function() {
      let currentIdx = 0;
      const totalImages = projectImages.length;

      const mainImg = document.getElementById(`main-img-${modalId}`);
      const captionTitle = document.getElementById(`caption-title-${modalId}`);
      const captionText = document.getElementById(`caption-text-${modalId}`);
      const counter = document.getElementById(`counter-${modalId}`);
      const prevBtn = document.getElementById(`prev-btn-${modalId}`);
      const nextBtn = document.getElementById(`next-btn-${modalId}`);
      const thumbBtns = document.querySelectorAll(`.thumb-btn-${modalId}`);

      function updateGallery(idx) {
        currentIdx = (idx + totalImages) % totalImages;
        const currentData = projectImages[currentIdx];

        if (mainImg) {
          mainImg.src = currentData.url;
          mainImg.alt = currentData.title;
        }
        if (captionTitle) captionTitle.textContent = currentData.title;
        if (captionText) captionText.textContent = currentData.caption || '';
        if (counter) counter.textContent = (currentIdx + 1).toString();

        thumbBtns.forEach((btn, bIdx) => {
          if (bIdx === currentIdx) {
            btn.className = `thumb-btn-${modalId} text-left p-1.5 sm:p-2 rounded-xl border transition-all cursor-pointer flex flex-col gap-1.5 border-cyan-500 bg-cyan-500/10 ring-2 ring-cyan-500/40 shadow-sm`;
          } else {
            btn.className = `thumb-btn-${modalId} text-left p-1.5 sm:p-2 rounded-xl border transition-all cursor-pointer flex flex-col gap-1.5 border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 hover:border-slate-400 dark:hover:border-white/30`;
          }
        });
      }

      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        updateGallery(currentIdx - 1);
      });

      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        updateGallery(currentIdx + 1);
      });

      thumbBtns.forEach((btn, idx) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          updateGallery(idx);
        });
      });
    })();
  </script>
</div>
