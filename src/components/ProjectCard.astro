---
import { Github, Zap, ArrowUpRight, FileText, CheckCircle2, X } from 'lucide-astro';

interface Props {
  id?: string;
  title: string;
  role: "Full-Stack" | "DevOps/SRE" | "Hybrid";
  description: string;
  impact: string;
  stack: string[];
  github?: string;
  demo?: string;
  featured?: boolean;
}

const { id, title, role, description, impact, stack, github, demo, featured = false } = Astro.props;

const roleConfig = {
  "Full-Stack": {
    badge: "border-cyan-500/30 bg-cyan-50 dark:bg-cyan-950/40 text-cyan-700 dark:text-cyan-300",
    dot: "bg-cyan-500 dark:bg-cyan-400",
    glow: "group-hover:border-cyan-500/50",
  },
  "DevOps/SRE": {
    badge: "border-violet-500/30 bg-violet-50 dark:bg-violet-950/40 text-violet-700 dark:text-violet-300",
    dot: "bg-violet-500 dark:bg-violet-400",
    glow: "group-hover:border-violet-500/50",
  },
  "Hybrid": {
    badge: "border-amber-500/30 bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300",
    dot: "bg-amber-500 dark:bg-amber-400",
    glow: "group-hover:border-amber-500/50",
  },
};

const currentRole = roleConfig[role] || roleConfig["Full-Stack"];
const modalId = `modal-${Math.random().toString(36).substring(2, 9)}`;
---

<div
  class={`group relative rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0c121e]/80 backdrop-blur-md p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 shadow-sm hover:shadow-xl ${currentRole.glow} ${featured ? 'lg:col-span-2' : ''}`}
  data-role={role}
>
  <div>
    <!-- Card Header -->
    <div class="flex items-center justify-between gap-3 mb-4">
      <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono border font-medium ${currentRole.badge}`}>
        <span class={`w-1.5 h-1.5 rounded-full ${currentRole.dot}`}></span>
        <span>{role}</span>
      </span>

      <!-- Action Links -->
      <div class="flex items-center gap-2">
        {github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors shadow-sm"
            title="Inspect GitHub Repository"
            aria-label={`${title} GitHub Repository`}
          >
            <Github class="w-4 h-4" />
          </a>
        )}
        {demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-400 hover:text-cyan-600 dark:hover:text-cyan-400 hover:border-cyan-500/30 transition-colors shadow-sm"
            title="Launch Live Production Target"
            aria-label={`${title} Live Demo`}
          >
            <ArrowUpRight class="w-4 h-4" />
          </a>
        )}
      </div>
    </div>

    <!-- Title -->
    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight group-hover:text-cyan-600 dark:group-hover:text-cyan-300 transition-colors">
      {title}
    </h3>

    <!-- Impact Metric Badge -->
    <div class="mt-3.5 inline-flex items-start sm:items-center gap-2 p-2.5 rounded-xl border border-emerald-500/20 bg-emerald-500/10 dark:bg-emerald-950/20 text-emerald-800 dark:text-emerald-300 text-xs font-mono w-full">
      <Zap class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5 sm:mt-0" />
      <div class="leading-snug">
        <span data-i18n="projects.impactLabel" class="text-slate-600 dark:text-slate-400 font-normal">Engineering Impact: </span>
        <strong class="font-semibold text-emerald-800 dark:text-emerald-300">{impact}</strong>
      </div>
    </div>

    <!-- Description -->
    <p class="mt-4 text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
      {description}
    </p>
  </div>

  <!-- Tech Stack Chips & Action Bar -->
  <div class="mt-6 pt-5 border-t border-slate-200 dark:border-slate-800/80 space-y-4">
    <div class="flex flex-wrap items-center gap-2">
      {stack.map((item) => (
        <span class="px-2.5 py-1 rounded-md text-[11px] font-mono bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 group-hover:border-slate-300 dark:group-hover:border-slate-700 transition-colors">
          {item}
        </span>
      ))}
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center gap-2.5 pt-1">
      <button
        type="button"
        onclick={`document.getElementById('${modalId}').showModal()`}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-cyan-500/30 bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 text-xs font-mono font-medium hover:bg-cyan-500/20 transition-colors cursor-pointer shadow-sm"
      >
        <FileText class="w-3.5 h-3.5" />
        <span data-i18n="projects.btnWriteup">Architecture Writeup</span>
      </button>

      {github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white text-xs font-mono transition-colors"
        >
          <Github class="w-3.5 h-3.5" />
          <span data-i18n="projects.btnRepo">GitHub Repo</span>
        </a>
      )}

      {demo && (
        <a
          href={demo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-400 hover:text-cyan-600 dark:hover:text-cyan-300 text-xs font-mono transition-colors"
        >
          <ArrowUpRight class="w-3.5 h-3.5" />
          <span data-i18n="projects.btnDemo">Live Target</span>
        </a>
      )}
    </div>
  </div>

  <!-- Sleek Architecture Writeup Modal Dialog -->
  <dialog
    id={modalId}
    class="backdrop:bg-black/75 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0c121e] text-slate-800 dark:text-slate-200 p-0 max-w-2xl w-full shadow-2xl m-auto"
  >
    <div class="p-6 sm:p-7 space-y-5">
      <!-- Modal Header -->
      <div class="flex items-start justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-4">
        <div>
          <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono border font-medium mb-2 ${currentRole.badge}`}>
            {role}
          </span>
          <h4 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">
            {title}
          </h4>
        </div>
        <button
          type="button"
          onclick={`document.getElementById('${modalId}').close()`}
          class="p-2 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-500 hover:text-slate-900 dark:hover:text-white cursor-pointer"
          aria-label="Close Architecture Modal"
        >
          <X class="w-4 h-4" />
        </button>
      </div>

      <!-- Modal Content Body -->
      <div class="space-y-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300 font-sans">
        <div class="p-3.5 rounded-xl border border-emerald-500/20 bg-emerald-500/10 dark:bg-emerald-950/20 text-emerald-800 dark:text-emerald-300 font-mono text-xs">
          <strong>Measured Result: </strong> {impact}
        </div>

        <p>{description}</p>

        <div>
          <h5 class="text-xs font-mono uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2">Production Tech Stack</h5>
          <div class="flex flex-wrap gap-1.5">
            {stack.map((item) => (
              <span class="px-2 py-0.5 rounded text-xs font-mono bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">
                {item}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="pt-4 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between">
        <span class="text-xs font-mono text-slate-400">Architecture Case Study</span>
        <div class="flex items-center gap-2">
          {github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 text-xs font-mono text-slate-700 dark:text-slate-300 hover:text-white hover:bg-slate-800 transition-colors"
            >
              Inspect Source
            </a>
          )}
          <button
            type="button"
            onclick={`document.getElementById('${modalId}').close()`}
            class="px-4 py-1.5 rounded-lg bg-cyan-500 text-slate-950 text-xs font-mono font-bold hover:bg-cyan-400 transition-colors cursor-pointer"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  </dialog>
</div>
