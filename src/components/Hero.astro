---
import { Terminal, Shield, ArrowUpRight, Github, Linkedin, FileText, CheckCircle2, Cpu, Server, Activity, ArrowRight } from 'lucide-astro';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Headline & Value Proposition -->
      <div class="lg:col-span-7 flex flex-col items-start space-y-6">
        
        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-emerald-500/30 bg-emerald-950/30 text-emerald-300 text-xs font-mono backdrop-blur-sm shadow-sm">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="font-medium">Open for Senior Full-Stack & DevOps/SRE Roles</span>
        </div>

        <!-- High-Impact Dual Discipline Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12]">
          Building <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-400">Scalable Web Apps</span>,
          Hardening <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 via-purple-300 to-indigo-400">Resilient Infrastructure</span>.
        </h1>

        <!-- Subheadline / Value Proposition for Tech Leads & HR -->
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
          I am a <strong>Full-Stack Developer</strong> and <strong>DevOps/SRE Architect</strong> bridging the gap between elegant application software and mission-critical cloud infrastructure. I architect distributed backends, build responsive SPAs, and automate zero-downtime GitOps pipelines engineered for 99.99% reliability.
        </p>

        <!-- Metric Badges -->
        <div class="grid grid-cols-3 gap-3 sm:gap-4 w-full max-w-xl py-2">
          <div class="p-3.5 rounded-xl border border-slate-800 bg-slate-900/50 backdrop-blur-sm">
            <div class="text-xl sm:text-2xl font-bold font-mono text-cyan-400">99.99%</div>
            <div class="text-[11px] text-slate-400 uppercase tracking-wider font-mono mt-0.5">Uptime Target</div>
          </div>
          <div class="p-3.5 rounded-xl border border-slate-800 bg-slate-900/50 backdrop-blur-sm">
            <div class="text-xl sm:text-2xl font-bold font-mono text-emerald-400">&lt; 45ms</div>
            <div class="text-[11px] text-slate-400 uppercase tracking-wider font-mono mt-0.5">p99 Latency SLA</div>
          </div>
          <div class="p-3.5 rounded-xl border border-slate-800 bg-slate-900/50 backdrop-blur-sm">
            <div class="text-xl sm:text-2xl font-bold font-mono text-violet-400">100%</div>
            <div class="text-[11px] text-slate-400 uppercase tracking-wider font-mono mt-0.5">IaC & Automated CI</div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-3.5 pt-2">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-slate-950 font-semibold text-sm hover:from-cyan-400 hover:to-blue-500 transition-all shadow-lg shadow-cyan-500/20 active:scale-95"
          >
            <span>Explore Bento Projects</span>
            <ArrowRight class="w-4 h-4" />
          </a>

          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl border border-slate-700 bg-slate-800/80 hover:bg-slate-750 text-slate-200 hover:text-white font-medium text-sm transition-all hover:border-slate-600"
          >
            <FileText class="w-4 h-4 text-cyan-400" />
            <span>Download Resume</span>
          </a>

          <div class="flex items-center gap-2">
            <a
              href="https://github.com"
              target="_blank"
              rel="noopener noreferrer"
              class="p-3 rounded-xl border border-slate-800 bg-slate-900/80 text-slate-300 hover:text-white hover:border-slate-700 transition-all"
              aria-label="GitHub"
            >
              <Github class="w-4 h-4" />
            </a>
            <a
              href="https://linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              class="p-3 rounded-xl border border-slate-800 bg-slate-900/80 text-slate-300 hover:text-white hover:border-slate-700 transition-all"
              aria-label="LinkedIn"
            >
              <Linkedin class="w-4 h-4" />
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Terminal & Architecture Inspector -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl border border-slate-800 bg-[#0c121e]/90 backdrop-blur-md shadow-2xl overflow-hidden box-glow">
          <!-- Terminal Window Header -->
          <div class="px-4 py-3 bg-[#0a0f1a] border-b border-slate-800/80 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
            </div>
            <div class="text-xs font-mono text-slate-400 flex items-center gap-1.5">
              <Terminal class="w-3.5 h-3.5 text-cyan-400" />
              <span>infra-pipeline.yaml &bull; live</span>
            </div>
            <div class="flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-[10px] font-mono text-emerald-400">HEALTHY</span>
            </div>
          </div>

          <!-- Terminal Content / Code Demonstration -->
          <div class="p-5 font-mono text-xs leading-relaxed overflow-x-auto space-y-3">
            <div class="flex items-center text-slate-400">
              <span class="text-emerald-400 select-none mr-2">$</span>
              <span>deploy-mesh --env production --canary-weight 10%</span>
            </div>

            <div class="text-slate-400 pl-4 border-l border-slate-800 space-y-1.5 py-1">
              <div class="flex items-center text-cyan-300">
                <span class="text-slate-500 mr-2">[1/4]</span>
                <span>Testing OpenAPI schema contracts:</span>
                <span class="ml-2 text-emerald-400 font-bold">PASSED (142 tests)</span>
              </div>
              <div class="flex items-center text-slate-300">
                <span class="text-slate-500 mr-2">[2/4]</span>
                <span>Building multi-stage scratch Docker container:</span>
                <span class="ml-2 text-cyan-400">18.4MB</span>
              </div>
              <div class="flex items-center text-slate-300">
                <span class="text-slate-500 mr-2">[3/4]</span>
                <span>ArgoCD GitOps synchronization:</span>
                <span class="ml-2 text-emerald-400">Synced to commit 8f9b2a</span>
              </div>
              <div class="flex items-center text-violet-300">
                <span class="text-slate-500 mr-2">[4/4]</span>
                <span>Prometheus p99 latency verification:</span>
                <span class="ml-2 text-emerald-400">32ms &lt; 50ms (OK)</span>
              </div>
            </div>

            <div class="pt-2 border-t border-slate-800/80 text-[11px] text-slate-400 flex justify-between items-center">
              <span class="text-emerald-400 flex items-center gap-1">
                <CheckCircle2 class="w-3.5 h-3.5" />
                <span>Rollout Completed &bull; Zero Downtime</span>
              </span>
              <span class="text-slate-500">Duration: 18.2s</span>
            </div>
          </div>

          <!-- Bottom Telemetry Bar -->
          <div class="bg-[#090d16] px-4 py-2.5 border-t border-slate-800 flex items-center justify-between text-[11px] font-mono text-slate-400">
            <div class="flex items-center gap-2">
              <Cpu class="w-3.5 h-3.5 text-cyan-400" />
              <span>CPU: 14%</span>
            </div>
            <div class="flex items-center gap-2">
              <Server class="w-3.5 h-3.5 text-violet-400" />
              <span>Pods: 12/12 Ready</span>
            </div>
            <div class="flex items-center gap-2">
              <Activity class="w-3.5 h-3.5 text-emerald-400" />
              <span>HTTP 200: 99.99%</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
