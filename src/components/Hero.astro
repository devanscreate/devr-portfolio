---
import { ArrowRight, Sparkles, Check, Globe2, ShieldCheck, Zap } from 'lucide-astro';
import { Image } from 'astro:assets';
import devPortrait from '../assets/images/dev_portrait.jpg';
---

<section class="relative pt-8 pb-16 md:pt-14 md:pb-24 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Status Badge -->
    <div class="flex justify-center md:justify-start mb-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-slate-300 dark:border-white/10 bg-white dark:bg-white/5 text-slate-800 dark:text-slate-200 text-xs font-semibold shadow-sm">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span data-i18n="hero.status">Full-Stack Software Engineer & Cloud Architect</span>
      </div>
    </div>

    <!-- Massive Punchy Editorial Typography (Exact Bebas Neue Vibe from Reference Image) -->
    <div class="w-full text-center md:text-left mb-6 sm:mb-8">
      <h1 
        class="font-display font-black tracking-tight uppercase leading-[0.88] text-slate-900 dark:text-white select-none text-[52px] xs:text-[64px] sm:text-[90px] md:text-[115px] lg:text-[142px] xl:text-[160px] transition-all"
        data-i18n="hero.headline"
      >
        FULL-STACK DEVELOPER
      </h1>
    </div>

    <!-- 2 Subtitle Columns + CTA Link (Exact layout from reference image) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start mb-12 sm:mb-16">
      <div class="md:col-span-5">
        <p data-i18n="hero.leftText" class="text-sm sm:text-base text-slate-700 dark:text-slate-300 font-medium leading-relaxed">
          Saya membantu bisnis, startup, dan UMKM membangun aplikasi web modern yang cepat, indah, dan mudah digunakan pelanggan.
        </p>
      </div>

      <div class="md:col-span-4">
        <p data-i18n="hero.rightText" class="text-sm sm:text-base text-slate-500 dark:text-slate-400 leading-relaxed">
          Menyatukan desain antarmuka yang ramah pengguna dengan sistem server handal di belakang layar yang stabil dan anti-down.
        </p>
      </div>

      <div class="md:col-span-3 flex md:justify-end items-center pt-2 md:pt-0">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 text-sm sm:text-base font-extrabold uppercase tracking-wider text-slate-900 dark:text-white group border-b-2 border-slate-900 dark:border-white pb-1 hover:text-cyan-500 hover:border-cyan-500 dark:hover:text-cyan-400 dark:hover:border-cyan-400 transition-all"
        >
          <span data-i18n="hero.ctaTouch">HUBUNGI SAYA &rarr;</span>
        </a>
      </div>
    </div>

    <!-- Centerpiece: Arched Container with Grid Background, Silhouette Portrait & Interactive Stickers -->
    <div class="relative w-full max-w-5xl mx-auto pt-6">
      
      <!-- Arched Pill Wrapper with Grid Pattern -->
      <div class="relative w-full h-[400px] sm:h-[480px] md:h-[560px] lg:h-[620px] rounded-t-[100px] sm:rounded-t-[160px] md:rounded-t-[240px] rounded-b-[32px] sm:rounded-b-[48px] arch-grid-light dark:arch-grid-light border-2 border-slate-900/10 dark:border-white/20 overflow-hidden shadow-2xl flex items-end justify-center">
        
        <!-- Subtle Inner Top Vignette / Depth -->
        <div class="absolute inset-0 pointer-events-none bg-gradient-to-b from-black/5 via-transparent to-black/10"></div>

        <!-- Center Cutout/Portrait Image -->
        <div class="relative z-10 w-auto h-[88%] sm:h-[92%] flex items-end justify-center">
          <Image
            src={devPortrait}
            alt="Devan Regiana - Full-Stack Developer"
            class="h-full w-auto object-contain object-bottom filter drop-shadow-[0_20px_35px_rgba(0,0,0,0.35)] select-none pointer-events-none"
            loading="eager"
            fetchpriority="high"
            format="webp"
            quality={85}
          />
        </div>

        <!-- ================= VIBRANT PLAYFUL STICKERS (OVERLAPPING LIKE REFERENCE IMAGE) ================= -->

        <!-- STICKER 1: Round Mint / Cyan Badge (Top-Left) -->
        <div class="absolute top-6 sm:top-10 left-3 sm:left-10 z-20 transition-transform duration-300 hover:scale-110 hover:rotate-0 hover:z-30 cursor-pointer -rotate-6 animate-float-slow">
          <div class="w-24 h-24 sm:w-32 sm:h-32 md:w-36 md:h-36 rounded-full bg-[#4ddcd0] text-slate-950 p-2 sm:p-3 flex flex-col items-center justify-center text-center border-2 border-slate-950 sticker-shadow sticker-shadow-hover">
            <!-- Interlocking Circles Icon -->
            <div class="flex items-center -space-x-1.5 mb-1">
              <div class="w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-full bg-slate-950"></div>
              <div class="w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-full border-2 border-slate-950"></div>
            </div>
            <span data-i18n="hero.sticker1Top" class="font-display font-black text-xs sm:text-sm md:text-base leading-tight tracking-tight uppercase">
              WEB & APPS
            </span>
            <span data-i18n="hero.sticker1Sub" class="text-[8px] sm:text-[9px] md:text-[10px] font-bold tracking-tight uppercase mt-0.5 text-slate-900 leading-tight">
              MODERN • RESPONSIF
            </span>
          </div>
        </div>

        <!-- STICKER 2: Bright Yellow Chunky Ticket (Middle-Left) -->
        <div class="absolute top-[42%] sm:top-[44%] left-2 sm:left-6 md:left-8 z-20 transition-transform duration-300 hover:scale-110 hover:rotate-0 hover:z-30 cursor-pointer rotate-6">
          <div class="px-3.5 py-2 sm:px-4 sm:py-2.5 md:px-5 md:py-3 rounded-xl bg-[#fed22b] text-slate-950 font-black border-2 border-slate-950 sticker-shadow sticker-shadow-hover flex items-center gap-1.5 sm:gap-2">
            <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-slate-950 inline-block"></span>
            <div class="flex flex-col">
              <span data-i18n="hero.sticker2Top" class="font-display text-xs sm:text-sm md:text-base tracking-tight uppercase leading-none">
                E-COMMERCE ⚡
              </span>
              <span data-i18n="hero.sticker2Sub" class="text-[8px] sm:text-[9px] font-bold tracking-wider text-slate-800 uppercase mt-0.5">
                KONVERSI TINGGI
              </span>
            </div>
          </div>
        </div>

        <!-- STICKER 3: Orange Motion Pill (Bottom-Left) -->
        <div class="absolute bottom-6 sm:bottom-10 left-3 sm:left-12 md:left-16 z-20 transition-transform duration-300 hover:scale-110 hover:rotate-0 hover:z-30 cursor-pointer -rotate-3">
          <div class="px-3.5 py-2.5 sm:px-5 sm:py-3 rounded-xl bg-[#ff6b2b] text-white font-black border-2 border-slate-950 sticker-shadow sticker-shadow-hover">
            <div class="flex items-center gap-1.5 text-slate-950 mb-0.5">
              <span class="text-[10px] tracking-widest font-mono">&mdash;&mdash;&gt;</span>
              <Zap class="w-3 h-3 text-white fill-white" />
            </div>
            <span data-i18n="hero.sticker3Top" class="font-display text-xs sm:text-sm md:text-base tracking-tight uppercase block leading-tight text-white">
              SUPER CEPAT
            </span>
            <span data-i18n="hero.sticker3Sub" class="text-[8px] sm:text-[9px] font-bold uppercase tracking-wider text-amber-100 block mt-0.5">
              LOAD &lt; 1 DETIK
            </span>
          </div>
        </div>

        <!-- STICKER 4: Neon Pink / Coral Pill Badge (Middle-Right) -->
        <div class="absolute top-[28%] sm:top-[30%] right-3 sm:right-8 md:right-12 z-20 transition-transform duration-300 hover:scale-110 hover:rotate-0 hover:z-30 cursor-pointer rotate-3 animate-float-slow">
          <div class="px-4 py-2.5 sm:px-5 sm:py-3.5 md:px-6 md:py-4 rounded-2xl bg-[#ff3366] text-white font-black border-2 border-slate-950 sticker-shadow sticker-shadow-hover text-center">
            <span data-i18n="hero.sticker4Top" class="font-display text-xs sm:text-base md:text-lg tracking-tight uppercase block leading-none">
              USER EXPERIENCE
            </span>
            <span data-i18n="hero.sticker4Sub" class="text-[8px] sm:text-[10px] font-bold uppercase tracking-wider text-pink-100 block mt-1">
              DESAIN RAMAH &copy;
            </span>
          </div>
        </div>

        <!-- STICKER 5: Mint/Teal Angled Card (Far-Right / Lower-Right) -->
        <div class="absolute top-[60%] sm:top-[62%] right-2 sm:right-6 md:right-8 z-20 transition-transform duration-300 hover:scale-110 hover:rotate-0 hover:z-30 cursor-pointer -rotate-6">
          <div class="px-3.5 py-2 sm:px-4 sm:py-2.5 md:px-5 md:py-3 rounded-xl bg-[#52dfc5] text-slate-950 font-black border-2 border-slate-950 sticker-shadow sticker-shadow-hover">
            <div class="flex items-center justify-between mb-0.5">
              <span data-i18n="hero.sticker5Top" class="font-display text-xs sm:text-sm md:text-base tracking-tight uppercase leading-none">
                CLOUD & SERVER
              </span>
              <span class="text-xs">✦</span>
            </div>
            <span data-i18n="hero.sticker5Sub" class="text-[8px] sm:text-[9px] font-bold uppercase tracking-wider text-slate-800 block">
              ANTI-DOWN '26
            </span>
          </div>
        </div>

        <!-- STICKER 6: Neon Green Circular Stamp Seal (Bottom-Right) -->
        <div class="absolute bottom-4 sm:bottom-6 right-8 sm:right-20 md:right-24 z-20 transition-transform duration-500 hover:rotate-180 hover:scale-110 hover:z-30 cursor-pointer rotate-12">
          <div class="w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 rounded-full bg-[#b8ff33] text-slate-950 p-2 flex flex-col items-center justify-center text-center border-2 border-slate-950 sticker-shadow sticker-shadow-hover">
            <Globe2 class="w-4 h-4 sm:w-5 sm:h-5 text-slate-950 mb-0.5" />
            <span data-i18n="hero.sticker6Top" class="font-display text-[10px] sm:text-xs font-black uppercase leading-tight tracking-tight">
              ★ 100% TERUJI ★
            </span>
            <span data-i18n="hero.sticker6Sub" class="text-[7px] sm:text-[8px] font-bold uppercase tracking-wider mt-0.5">
              SIAP PAKAI
            </span>
          </div>
        </div>

      </div>

      <!-- Quick Scroll Anchor Indicator -->
      <div class="flex justify-center mt-6">
        <a
          href="#projects"
          data-i18n="hero.ctaProjects"
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:text-slate-950 dark:hover:text-white transition-colors"
        >
          <span>LIHAT KARYA &darr;</span>
        </a>
      </div>

    </div>

  </div>
</section>
