---
import { ShieldCheck, Sparkles, Activity, Lock, Gauge, CheckCircle2, HeartHandshake, Zap, Smile } from 'lucide-astro';

const principles = [
  {
    icon: Smile,
    titleKey: "standards.card1Title",
    descKey: "standards.card1Desc",
    metricKey: "standards.card1Metric",
    title: "Mudah Dipahami Siapa Saja",
    description: "Desain antarmuka dibuat sangat intuitif sehingga pelanggan maupun staf kantor tidak perlu pelatihan rumit untuk menggunakannya.",
    metric: "Ramah Pengguna",
    accent: "text-amber-500",
  },
  {
    icon: Zap,
    titleKey: "standards.card2Title",
    descKey: "standards.card2Desc",
    metricKey: "standards.card2Metric",
    title: "Website Super Cepat & Ringan",
    description: "Dioptimalkan agar halaman terbuka dalam sekejap (< 1 detik) di HP maupun laptop, membuat calon pembeli betah berbelanja.",
    metric: "< 1 Detik Buka",
    accent: "text-cyan-500",
  },
  {
    icon: Gauge,
    titleKey: "standards.card3Title",
    descKey: "standards.card3Desc",
    metricKey: "standards.card3Metric",
    title: "Server Kokoh & Anti-Down",
    description: "Pengaturan server cloud cerdas yang menjaga website tetap hidup 24 jam nonstop bahkan saat promo flash sale dibanjiri pengunjung.",
    metric: "99.99% Online",
    accent: "text-violet-500",
  },
  {
    icon: Lock,
    titleKey: "standards.card4Title",
    descKey: "standards.card4Desc",
    metricKey: "standards.card4Metric",
    title: "Keamanan Data Standar Industri",
    description: "Enkripsi data sensitif, transaksi pembayaran yang aman, dan perlindungan otomatis dari spam serta bot peretas.",
    metric: "Aman & Terenkripsi",
    accent: "text-rose-500",
  },
  {
    icon: ShieldCheck,
    titleKey: "standards.card5Title",
    descKey: "standards.card5Desc",
    metricKey: "standards.card5Metric",
    title: "Integrasi Sistem Lengkap",
    description: "Mudah disambungkan ke WhatsApp otomatis, Payment Gateway (Midtrans/Xendit), dan sistem kasir/gudang yang sudah ada.",
    metric: "Terhubung Otomatis",
    accent: "text-blue-500",
  },
  {
    icon: HeartHandshake,
    titleKey: "standards.card6Title",
    descKey: "standards.card6Desc",
    metricKey: "standards.card6Metric",
    title: "Komunikasi Ramah & Transparan",
    description: "Laporan perkembangan proyek disampaikan secara berkala dengan bahasa yang mudah dipahami tanpa jargon teknis membingungkan.",
    metric: "Laporan Jelas",
    accent: "text-emerald-500",
  },
];
---

<section id="standards" class="py-20 sm:py-28 border-t border-slate-200 dark:border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center mb-14 sm:mb-18">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-widest mb-3 shadow-sm">
        <Sparkles class="w-3.5 h-3.5 text-cyan-500" />
        <span data-i18n="standards.badge">Jaminan Kualitas</span>
      </div>
      <h2 data-i18n="standards.title" class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        Mengapa Memilih Bekerja Sama Dengan Saya?
      </h2>
      <p data-i18n="standards.subtitle" class="mt-3 text-slate-600 dark:text-slate-400 max-w-2xl text-sm sm:text-base leading-relaxed">
        Saya tidak hanya menulis kode, tetapi menciptakan aset digital andal yang siap membantu pertumbuhan bisnis Anda.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {principles.map((item) => (
        <div class="rounded-3xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#0f1117] p-7 flex flex-col justify-between hover:border-slate-400 dark:hover:border-white/25 transition-all shadow-sm hover:shadow-xl group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class={`w-11 h-11 rounded-2xl bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 flex items-center justify-center ${item.accent} group-hover:scale-105 transition-transform`}>
                <item.icon class="w-5 h-5" />
              </div>
              <span data-i18n={item.metricKey} class="text-[11px] font-bold px-3 py-1 rounded-full bg-emerald-500/10 dark:bg-emerald-950/30 border border-emerald-500/20 text-emerald-800 dark:text-emerald-300">
                {item.metric}
              </span>
            </div>
            <h3 data-i18n={item.titleKey} class="text-lg font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">
              {item.title}
            </h3>
            <p data-i18n={item.descKey} class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed font-normal">
              {item.description}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 dark:border-white/5 flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
            <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0" />
            <span data-i18n="standards.enforced">Diterapkan pada Setiap Proyek</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
