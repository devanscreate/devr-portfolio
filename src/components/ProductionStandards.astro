---
import { ShieldCheck, GitPullRequest, Activity, Terminal, Lock, Gauge, CheckCircle2 } from 'lucide-astro';

const principles = [
  {
    icon: Lock,
    titleKey: "standards.card1Title",
    descKey: "standards.card1Desc",
    metricKey: "standards.card1Metric",
    title: "Least Privilege Security",
    description: "Enforcing non-root scratch containers, strictly bounded file permissions, systemd isolation, and restrictive firewall rules.",
    metric: "Restricted Access",
  },
  {
    icon: Terminal,
    titleKey: "standards.card2Title",
    descKey: "standards.card2Desc",
    metricKey: "standards.card2Metric",
    title: "Immutable Deployments",
    description: "Never mutating live servers in-place. Every release builds fresh, disposable container images with verified hashes.",
    metric: "Zero In-Place Edits",
  },
  {
    icon: GitPullRequest,
    titleKey: "standards.card3Title",
    descKey: "standards.card3Desc",
    metricKey: "standards.card3Metric",
    title: "Idempotent Automation",
    description: "CI/CD and configuration tasks that produce deterministic outcomes regardless of how many times they are executed.",
    metric: "Deterministic State",
  },
  {
    icon: Gauge,
    titleKey: "standards.card4Title",
    descKey: "standards.card4Desc",
    metricKey: "standards.card4Metric",
    title: "Nginx Zero-Downtime Reloads",
    description: "Validating configuration with syntax checks prior to graceful process reloads, preventing client connection drops.",
    metric: "0s Connection Drops",
  },
  {
    icon: ShieldCheck,
    titleKey: "standards.card5Title",
    descKey: "standards.card5Desc",
    metricKey: "standards.card5Metric",
    title: "Decoupled Fault Isolation",
    description: "Partitioning CPU-bound workers and socket bridges from synchronous HTTP workers to prevent cascading outages.",
    metric: "Isolated Boundaries",
  },
  {
    icon: Activity,
    titleKey: "standards.card6Title",
    descKey: "standards.card6Desc",
    metricKey: "standards.card6Metric",
    title: "Continuous Observability & Healthchecks",
    description: "Automated socket healthchecks, structured log aggregation, and real-time process monitoring via Linux systemd & Prometheus.",
    metric: "Sub-Second Telemetry",
  },
];
---

<section id="standards" class="py-20 border-t border-slate-200 dark:border-slate-850 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-mono text-emerald-600 dark:text-emerald-400 uppercase tracking-widest mb-3 shadow-sm">
        <Gauge class="w-3.5 h-3.5" />
        <span data-i18n="standards.badge">Operational Philosophy</span>
      </div>
      <h2 data-i18n="standards.title" class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Production Engineering Standards
      </h2>
      <p data-i18n="standards.subtitle" class="mt-4 text-slate-600 dark:text-slate-400 max-w-2xl text-base leading-relaxed">
        Practical engineering doctrine applied to every production workload to ensure reproducibility, security, and continuous reliability.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {principles.map((item) => (
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0c121e]/70 backdrop-blur-md p-6 flex flex-col justify-between hover:border-slate-300 dark:hover:border-slate-700 transition-colors shadow-sm">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 text-cyan-600 dark:text-cyan-400">
                <item.icon class="w-5 h-5" />
              </div>
              <span data-i18n={item.metricKey} class="text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-500/20 text-emerald-700 dark:text-emerald-400">
                {item.metric}
              </span>
            </div>
            <h3 data-i18n={item.titleKey} class="text-lg font-bold text-slate-900 dark:text-white tracking-tight mb-2">{item.title}</h3>
            <p data-i18n={item.descKey} class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{item.description}</p>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-200 dark:border-slate-850 flex items-center gap-2 text-[11px] font-mono text-slate-500">
            <CheckCircle2 class="w-3.5 h-3.5 text-emerald-500 dark:text-emerald-400" />
            <span data-i18n="standards.enforced">Enforced in Production Workflow</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
