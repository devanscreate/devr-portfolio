---
import { Code2, Server, Cloud, Database, Sparkles, CheckCircle2 } from 'lucide-astro';

const services = [
  {
    titleKey: "skills.catFrontend",
    title: "Tampilan Web & Antarmuka (Frontend)",
    desc: "Menciptakan tampilan visual yang memanjakan mata pembeli, nyaman diakses lewat smartphone, dan memandu pengunjung dengan mudah.",
    icon: Code2,
    badge: "Tampilan Ramah Pengguna",
    accent: "text-cyan-500",
    bgAccent: "from-cyan-500/10 to-transparent",
    skills: [
      { name: "Vue.js & React", benefit: "Halaman interaktif cepat tanpa reload lambat" },
      { name: "Tailwind CSS", benefit: "Desain responsif dan rapi di semua gadget" },
      { name: "TypeScript", benefit: "Kode stabil dan minim potensi error" },
      { name: "UI/UX Simpel", benefit: "Mudah dipahami oleh orang awam sekalipun" },
    ],
  },
  {
    titleKey: "skills.catBackend",
    title: "Sistem & Logika Data (Backend)",
    desc: "Jantung operasional aplikasi yang memproses pesanan, menghitung laporan keuangan, mengamankan kata sandi, dan menghubungkan pembayaran.",
    icon: Server,
    badge: "Otomatisasi Bisnis",
    accent: "text-blue-500",
    bgAccent: "from-blue-500/10 to-transparent",
    skills: [
      { name: "Laravel (PHP)", benefit: "Fondasi sistem perusahaan yang aman dan teruji" },
      { name: "Python (FastAPI)", benefit: "Pemrosesan data kilat dan automasi tugas" },
      { name: "Payment Gateway", benefit: "Pembayaran otomatis via QRIS, VA, & E-Wallet" },
      { name: "Sistem Notifikasi", benefit: "Pemberitahuan otomatis ke WhatsApp & Email" },
    ],
  },
  {
    titleKey: "skills.catInfra",
    title: "Hosting Cloud & Server (DevOps)",
    desc: "Memastikan website bisnis Anda selalu aktif 24 jam nonstop, tahan diserbu pengunjung saat flash sale, dan aman dari peretas.",
    icon: Cloud,
    badge: "Kestabilan 24/7",
    accent: "text-violet-500",
    bgAccent: "from-violet-500/10 to-transparent",
    skills: [
      { name: "Docker Container", benefit: "Aplikasi berjalan konsisten dan anti-crash" },
      { name: "Linux Ubuntu / Debian", benefit: "Server stabil, hemat daya, dan tahan banting" },
      { name: "Nginx Gateway", benefit: "Pengatur lalu lintas agar website anti-lemot" },
      { name: "Backup Otomatis", benefit: "Data perusahaan selalu aman tercadangkan" },
    ],
  },
  {
    titleKey: "skills.catDbNetwork",
    title: "Basis Data & Integrasi (Data & APIs)",
    desc: "Menyimpan seluruh data pelanggan dan inventaris secara aman serta menyinkronkan data antar sistem toko online dan kasir fisik.",
    icon: Database,
    badge: "Data Terintegrasi",
    accent: "text-emerald-500",
    bgAccent: "from-emerald-500/10 to-transparent",
    skills: [
      { name: "PostgreSQL & MySQL", benefit: "Penyimpanan data pesanan rapi & terstruktur" },
      { name: "Redis Caching", benefit: "Akses data super cepat dalam hitungan milidetik" },
      { name: "Integrasi API", benefit: "Menghubungkan cabang toko & marketplace" },
      { name: "Enkripsi Modern", benefit: "Privasi dan kerahasiaan data terjamin" },
    ],
  },
];
---

<section id="skills" class="py-20 sm:py-28 border-t border-slate-200 dark:border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center mb-14 sm:mb-18">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-widest mb-3 shadow-sm">
        <Sparkles class="w-3.5 h-3.5 text-amber-500" />
        <span data-i18n="skills.badge">Solusi & Kemampuan</span>
      </div>
      <h2 data-i18n="skills.title" class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        Solusi Digital untuk Bisnis Anda
      </h2>
      <p data-i18n="skills.subtitle" class="mt-3 text-slate-600 dark:text-slate-400 max-w-2xl text-sm sm:text-base leading-relaxed">
        Bukan sekadar bahasa pemrograman, tetapi solusi nyata untuk memecahkan masalah operasional dan meningkatkan penjualan Anda.
      </p>
    </div>

    <!-- 4 Clear Solution Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {services.map((svc) => {
        const Icon = svc.icon;
        return (
          <div class="rounded-3xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#0f1117] p-7 sm:p-8 flex flex-col justify-between hover:border-slate-400 dark:hover:border-white/25 transition-all shadow-sm hover:shadow-xl group">
            <div>
              <div class="flex items-center justify-between gap-3 mb-4">
                <div class="flex items-center gap-3">
                  <div class={`w-11 h-11 rounded-2xl bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 flex items-center justify-center ${svc.accent} group-hover:scale-105 transition-transform`}>
                    <Icon class="w-5 h-5" />
                  </div>
                  <div>
                    <h3 data-i18n={svc.titleKey} class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                      {svc.title}
                    </h3>
                    <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">
                      {svc.badge}
                    </span>
                  </div>
                </div>
              </div>

              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6 font-normal">
                {svc.desc}
              </p>

              <!-- Benefits List -->
              <div class="space-y-3 pt-4 border-t border-slate-100 dark:border-white/5">
                {svc.skills.map((skill) => (
                  <div class="flex items-start gap-2.5">
                    <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                    <div class="text-xs sm:text-sm">
                      <strong class="font-bold text-slate-900 dark:text-slate-100">{skill.name}</strong>
                      <span class="text-slate-500 dark:text-slate-400 font-normal"> &mdash; {skill.benefit}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
