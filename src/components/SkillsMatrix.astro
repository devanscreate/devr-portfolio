---
import { Code2, Server, Cloud, Database, Network, ShieldCheck, Terminal, Cpu } from 'lucide-astro';

const categorizedSkills = [
  {
    title: "Frontend Engineering",
    icon: Code2,
    accent: "text-cyan-500 dark:text-cyan-400",
    badge: "Layer 7 UI",
    skills: [
      { name: "Vue.js", level: "Production Core / Pinia / Vue Router" },
      { name: "Tailwind CSS", level: "Design Systems & Responsive UIs" },
      { name: "TypeScript", level: "Strict Typing & Client Contracts" },
      { name: "React", level: "Single-Page Applications & Hooks" },
      { name: "HTML5 Canvas", level: "High-FPS Data Visualization" },
    ],
  },
  {
    title: "Backend & Systems Logic",
    icon: Server,
    accent: "text-blue-500 dark:text-blue-400",
    badge: "Core Services",
    skills: [
      { name: "Python (FastAPI)", level: "Async APIs & Worker Daemons" },
      { name: "PHP (Laravel)", level: "Enterprise MVC & Eloquent" },
      { name: "WebSockets & TCP Sockets", level: "Real-Time Packet Streaming" },
      { name: "RESTful API Architecture", level: "OpenAPI Specification Contracts" },
      { name: "Process Management", level: "Multi-threading & Subprocesses" },
    ],
  },
  {
    title: "Infrastructure & DevOps",
    icon: Cloud,
    accent: "text-violet-500 dark:text-violet-400",
    badge: "Platform & Cloud",
    skills: [
      { name: "Linux (Debian / Ubuntu)", level: "Systemd Daemons & Kernel Tuning" },
      { name: "Nginx Gateway", level: "Reverse Proxy, TLS & Load Balancing" },
      { name: "Docker & Compose", level: "Multi-Stage Minimal Builds" },
      { name: "GitOps & CI/CD", level: "Automated GitHub Actions Pipelines" },
      { name: "Server Hardening", level: "UFW, Fail2ban, Least Privilege" },
    ],
  },
  {
    title: "Databases & Networking",
    icon: Database,
    accent: "text-emerald-500 dark:text-emerald-400",
    badge: "Data & Mesh",
    skills: [
      { name: "MySQL / MariaDB", level: "Schema Design, Indexing & Tuning" },
      { name: "PostgreSQL", level: "Relational Modeling & Transactions" },
      { name: "Microsoft SQL Server", level: "Enterprise Stored Procedures" },
      { name: "SSH Tunneling & Reverse Sockets", level: "Encrypted Port-Forwarding" },
      { name: "Network Routing & DNS", level: "Subnetting, NAT & Cloudflare Edge" },
    ],
  },
];
---

<section id="skills" class="py-20 border-t border-slate-200 dark:border-slate-850 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-mono text-cyan-600 dark:text-cyan-400 uppercase tracking-widest mb-3 shadow-sm">
        <Cpu class="w-3.5 h-3.5" />
        <span data-i18n="skills.badge">Technical Architecture Matrix</span>
      </div>
      <h2 data-i18n="skills.title" class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Categorized Engineering Depth
      </h2>
      <p data-i18n="skills.subtitle" class="mt-4 text-slate-600 dark:text-slate-400 max-w-2xl text-base leading-relaxed">
        Structured by hands-on production depth across frontend client applications, robust backend services, system internals, and network routing.
      </p>
    </div>

    <!-- 4-Grid Categorized Skill Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      {categorizedSkills.map((cat) => (
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0c121e]/70 backdrop-blur-md p-6 sm:p-7 space-y-5 shadow-sm hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
          <div class="flex items-center justify-between pb-3.5 border-b border-slate-200 dark:border-slate-850">
            <div class="flex items-center gap-3">
              <div class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60">
                <cat.icon class={`w-5 h-5 ${cat.accent}`} />
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white tracking-tight">
                {cat.title}
              </h3>
            </div>
            <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400">
              {cat.badge}
            </span>
          </div>

          <div class="space-y-2.5">
            {cat.skills.map((skill) => (
              <div class="p-3 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-slate-50 dark:bg-slate-900/50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 transition-colors hover:border-slate-300 dark:hover:border-slate-700">
                <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">{skill.name}</span>
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400">{skill.level}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Cross-Cutting Philosophy Bar -->
    <div class="mt-8 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/40 p-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-600 dark:text-slate-400 shadow-sm">
      <div class="flex items-center gap-2">
        <ShieldCheck class="w-4 h-4 text-emerald-500 dark:text-emerald-400" />
        <span data-i18n="skills.standardsTitle" class="text-slate-800 dark:text-slate-300 font-medium">Core Engineering Standards:</span>
        <span data-i18n="skills.standardsDesc" class="hidden md:inline">Least Privilege Security &bull; Immutable Deployments &bull; Idempotent Automation</span>
      </div>
      <div class="flex items-center gap-3 text-cyan-600 dark:text-cyan-400">
        <span data-i18n="skills.standardsTag">Zero Magic Deployments &bull; Everything as Code</span>
      </div>
    </div>

  </div>
</section>
