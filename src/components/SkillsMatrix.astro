---
import { Code2, Server, Cloud, Cpu, Database, GitBranch, Layers, ShieldCheck, Terminal, Activity, Network } from 'lucide-astro';

const appDevCategories = [
  {
    title: "Frontend Engineering",
    icon: Code2,
    accent: "text-cyan-400",
    border: "border-cyan-500/20",
    skills: [
      { name: "TypeScript", level: "Core / Advanced" },
      { name: "React / Next.js", level: "Production Standard" },
      { name: "Astro", level: "Static & Islands" },
      { name: "Vue.js", level: "Production Standard" },
      { name: "Tailwind CSS", level: "Design Systems" },
      { name: "State Machines / TanStack", level: "Reactive" },
    ],
  },
  {
    title: "Backend & Systems Logic",
    icon: Server,
    accent: "text-blue-400",
    border: "border-blue-500/20",
    skills: [
      { name: "Go (Golang)", level: "Concurrent Services" },
      { name: "Node.js / Express / Nest", level: "High Throughput" },
      { name: "Python / FastAPI", level: "Async APIs" },
      { name: "gRPC & Protocol Buffers", level: "Microservices" },
      { name: "REST & OpenAPI", level: "Contract-Driven" },
      { name: "GraphQL", level: "Unified Schemas" },
    ],
  },
  {
    title: "Data Stores & Streaming",
    icon: Database,
    accent: "text-teal-400",
    border: "border-teal-500/20",
    skills: [
      { name: "PostgreSQL", level: "Partitioning & Indexing" },
      { name: "Redis", level: "PubSub & Distributed Locks" },
      { name: "Apache Kafka", level: "Event Sourcing" },
      { name: "MongoDB", level: "Document Stores" },
      { name: "ClickHouse", level: "OLAP Analytics" },
      { name: "Prisma & Drizzle ORM", level: "Type-Safe Migrations" },
    ],
  },
];

const systemsSRECategories = [
  {
    title: "Containers & Orchestration",
    icon: Layers,
    accent: "text-violet-400",
    border: "border-violet-500/20",
    skills: [
      { name: "Kubernetes (K8s)", level: "Cluster Admin & HPA" },
      { name: "Docker & Containerd", level: "Multi-Stage Builds" },
      { name: "Helm Charts", level: "Templated Packaging" },
      { name: "ArgoCD", level: "GitOps Declarative" },
      { name: "Istio & Envoy", level: "Service Mesh & mTLS" },
      { name: "Docker Swarm", level: "Lightweight Deploy" },
    ],
  },
  {
    title: "Infrastructure as Code & CI/CD",
    icon: GitBranch,
    accent: "text-purple-400",
    border: "border-purple-500/20",
    skills: [
      { name: "Terraform / OpenTofu", level: "State & Modules" },
      { name: "GitHub Actions", level: "Canary & Matrix Pipelines" },
      { name: "GitLab CI", level: "Enterprise Runners" },
      { name: "Ansible", level: "Config Automation" },
      { name: "Cloudflare Workers & Pages", level: "Edge Execution" },
      { name: "AWS & GCP Core", level: "VPC, IAM, S3, EKS" },
    ],
  },
  {
    title: "Observability & Linux Systems",
    icon: Activity,
    accent: "text-emerald-400",
    border: "border-emerald-500/20",
    skills: [
      { name: "Prometheus & Alertmanager", level: "SLO/SLA Metrics" },
      { name: "Grafana Dashboards", level: "Golden Signals" },
      { name: "OpenTelemetry (OTel)", level: "Distributed Tracing" },
      { name: "Nginx & Caddy Proxy", level: "Reverse Proxy & TLS" },
      { name: "Linux Internals (Debian/RHEL)", level: "Kernel & Systemd" },
      { name: "Network Security & eBPF", level: "Packet Flow & IPTables" },
    ],
  },
];
---

<section id="skills" class="py-20 border-t border-slate-850 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-slate-900 border border-slate-800 text-xs font-mono text-cyan-400 uppercase tracking-widest mb-3">
        <Cpu class="w-3.5 h-3.5" />
        <span>Technical Architecture Matrix</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Dual-Discipline Engineering Depth
      </h2>
      <p class="mt-4 text-slate-400 max-w-2xl text-base leading-relaxed">
        Engineered for full ownership across the delivery lifecycle: from writing memory-efficient application logic to provisioning self-healing multi-node cloud clusters.
      </p>
    </div>

    <!-- Dual Discipline Two-Column Mega Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      
      <!-- Track 1: Application Development -->
      <div class="rounded-2xl border border-slate-800 bg-[#0c121e]/70 backdrop-blur-md p-6 sm:p-8 flex flex-col space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-850">
          <div class="flex items-center gap-3">
            <div class="p-2.5 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400">
              <Code2 class="w-6 h-6" />
            </div>
            <div>
              <h3 class="text-xl font-bold text-white tracking-tight">Application Development</h3>
              <p class="text-xs text-slate-400 font-mono">Frontend, Microservices, Data Models & APIs</p>
            </div>
          </div>
          <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">
            Layer 7 Focus
          </span>
        </div>

        <div class="space-y-6">
          {appDevCategories.map((cat) => (
            <div class="space-y-3">
              <div class="flex items-center gap-2 text-sm font-semibold text-slate-200">
                <cat.icon class={`w-4 h-4 ${cat.accent}`} />
                <span>{cat.title}</span>
              </div>
              <div class="grid grid-cols-2 gap-2.5">
                {cat.skills.map((skill) => (
                  <div class="p-2.5 rounded-lg border border-slate-800/80 bg-slate-900/60 hover:border-slate-700 transition-colors flex flex-col">
                    <span class="text-xs font-semibold text-slate-200">{skill.name}</span>
                    <span class="text-[10px] font-mono text-slate-500 mt-0.5">{skill.level}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Track 2: Systems, Cloud & SRE -->
      <div class="rounded-2xl border border-slate-800 bg-[#0c121e]/70 backdrop-blur-md p-6 sm:p-8 flex flex-col space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-850">
          <div class="flex items-center gap-3">
            <div class="p-2.5 rounded-xl bg-violet-500/10 border border-violet-500/30 text-violet-400">
              <Cloud class="w-6 h-6" />
            </div>
            <div>
              <h3 class="text-xl font-bold text-white tracking-tight">Systems & Cloud Architecture</h3>
              <p class="text-xs text-slate-400 font-mono">Kubernetes, IaC, GitOps, SRE Observability</p>
            </div>
          </div>
          <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-violet-500/10 text-violet-300 border border-violet-500/20">
            Infrastructure Focus
          </span>
        </div>

        <div class="space-y-6">
          {systemsSRECategories.map((cat) => (
            <div class="space-y-3">
              <div class="flex items-center gap-2 text-sm font-semibold text-slate-200">
                <cat.icon class={`w-4 h-4 ${cat.accent}`} />
                <span>{cat.title}</span>
              </div>
              <div class="grid grid-cols-2 gap-2.5">
                {cat.skills.map((skill) => (
                  <div class="p-2.5 rounded-lg border border-slate-800/80 bg-slate-900/60 hover:border-slate-700 transition-colors flex flex-col">
                    <span class="text-xs font-semibold text-slate-200">{skill.name}</span>
                    <span class="text-[10px] font-mono text-slate-500 mt-0.5">{skill.level}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Cross-Cutting Philosophy Bar -->
    <div class="mt-8 rounded-xl border border-slate-800/80 bg-slate-900/40 p-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-400">
      <div class="flex items-center gap-2">
        <ShieldCheck class="w-4 h-4 text-emerald-400" />
        <span class="text-slate-300 font-medium">Core Engineering Standards:</span>
        <span class="hidden md:inline">Immutable Infrastructure &bull; Automated Unit/Integration Testing &bull; Infrastructure as Code</span>
      </div>
      <div class="flex items-center gap-3 text-cyan-400">
        <span>Zero Magic Deployments</span>
        <span>&bull;</span>
        <span>Everything as Code</span>
      </div>
    </div>

  </div>
</section>
