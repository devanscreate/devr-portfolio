---
import { Mail, Send, Shield, Clock, MapPin, Github, Linkedin, MessageCircle, Copy, Check, Briefcase, ExternalLink, Sparkles, PhoneCall } from 'lucide-astro';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || "YOUR_ACCESS_KEY_HERE";
---

<section id="contact" class="py-20 sm:py-28 border-t border-slate-200 dark:border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center mb-14 sm:mb-18">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-widest mb-3 shadow-sm">
        <MessageCircle class="w-3.5 h-3.5 text-cyan-500" />
        <span data-i18n="contact.badge">Kontak Langsung</span>
      </div>
      <h2 data-i18n="contact.title" class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        Mari Wujudkan Ide Digital Anda Bersama Saya
      </h2>
      <p data-i18n="contact.subtitle" class="mt-3 text-slate-600 dark:text-slate-400 max-w-2xl text-sm sm:text-base leading-relaxed">
        Terbuka untuk pembuatan website baru, sistem bisnis perusahaan, konsultasi teknis, maupun posisi Full-Time.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Fast Direct Channels -->
      <div class="lg:col-span-5 rounded-3xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#0f1117] p-6 sm:p-8 space-y-6 shadow-sm">
        <div>
          <!-- Live Hiring Status Badge -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 dark:bg-emerald-950/30 text-emerald-800 dark:text-emerald-300 text-xs font-bold shadow-sm mb-3">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span data-i18n="contact.availBadge">Terbuka untuk Kerja Sama &bull; Siap Mulai 2026</span>
          </div>
          <h3 data-i18n="contact.availTitle" class="text-xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Status & Ketersediaan Saat Ini
          </h3>
          <p data-i18n="contact.availSub" class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-normal">
            Sedang aktif menerima proyek baru, pengembangan sistem, dan tawaran kerja sama jangka panjang.
          </p>
        </div>

        <div class="space-y-3.5 text-sm text-slate-700 dark:text-slate-300">
          
          <!-- Fast-Track WhatsApp Item -->
          <div class="p-4 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 dark:bg-emerald-950/20 flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400 shrink-0">
                <MessageCircle class="w-5 h-5" />
              </div>
              <div class="min-w-0">
                <span data-i18n="contact.whatsappLabel" class="text-xs font-bold text-emerald-900 dark:text-emerald-300 block">
                  Chat via WhatsApp
                </span>
                <span data-i18n="contact.whatsappSub" class="text-[11px] text-slate-500 dark:text-slate-400 block truncate">
                  Cara tercepat untuk berdiskusi langsung
                </span>
              </div>
            </div>
            <a
              href="https://wa.me/?text=Halo%20Devan,%20saya%20melihat%20portfolio%20Anda%20dan%20tertarik%20untuk%20mendiskusikan%20proyek%20website%20/%20aplikasi..."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-500 transition-all cursor-pointer shrink-0 shadow-sm"
            >
              <span>Chat</span>
              <ExternalLink class="w-3 h-3" />
            </a>
          </div>

          <!-- Direct Email Item with One-Click Copy -->
          <div class="p-4 rounded-2xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-slate-200 dark:bg-white/10 flex items-center justify-center text-slate-700 dark:text-slate-300 shrink-0">
                <Mail class="w-5 h-5" />
              </div>
              <div class="min-w-0">
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400 block">Alamat Email</span>
                <a href="mailto:dvnregiana007@gmail.com" class="text-slate-900 dark:text-white font-bold hover:underline break-all block text-xs sm:text-sm">
                  dvnregiana007@gmail.com
                </a>
              </div>
            </div>
            <button
              type="button"
              id="copy-email-btn"
              data-email="dvnregiana007@gmail.com"
              class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-white/10 text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white transition-all cursor-pointer shrink-0 shadow-sm"
              title="Salin Alamat Email"
            >
              <Copy class="w-3.5 h-3.5" id="copy-icon" />
              <Check class="w-3.5 h-3.5 text-emerald-500 hidden" id="check-icon" />
              <span id="copy-text" data-i18n="contact.copyEmail">Salin</span>
            </button>
          </div>

          <!-- Location -->
          <div class="p-4 rounded-2xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 flex items-start gap-3">
            <MapPin class="w-4 h-4 text-slate-500 dark:text-slate-400 shrink-0 mt-0.5" />
            <div>
              <span data-i18n="contact.locLabel" class="text-xs font-medium text-slate-500 dark:text-slate-400 block">Lokasi & Fleksibilitas</span>
              <span data-i18n="contact.locVal" class="text-slate-900 dark:text-white font-bold text-xs sm:text-sm leading-snug block">
                Indonesia (Jakarta / Bandung) & Remote Seluruh Indonesia
              </span>
            </div>
          </div>

          <!-- Response SLA Guarantee -->
          <div class="p-4 rounded-2xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 flex items-start gap-3">
            <Clock class="w-4 h-4 text-slate-500 dark:text-slate-400 shrink-0 mt-0.5" />
            <div>
              <span data-i18n="contact.slaLabel" class="text-xs font-medium text-slate-500 dark:text-slate-400 block">Jaminan Respons Cepat</span>
              <span data-i18n="contact.slaVal" class="text-slate-900 dark:text-white font-bold text-xs sm:text-sm block">
                Balasan dalam &lt; 24 Jam Dijamin
              </span>
            </div>
          </div>
        </div>

        <!-- Professional Profiles -->
        <div class="pt-4 border-t border-slate-100 dark:border-white/5">
          <span data-i18n="contact.profilesLabel" class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-3">
            Profil Profesional & Kode
          </span>
          <div class="flex flex-wrap items-center gap-3">
            <a href="https://github.com/devanscreate" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white transition-colors shadow-sm">
              <Github class="w-4 h-4" />
              <span>GitHub (@devanscreate)</span>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white transition-colors shadow-sm">
              <Linkedin class="w-4 h-4" />
              <span>LinkedIn</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Web3Forms Form -->
      <div class="lg:col-span-7 rounded-3xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#0f1117] p-6 sm:p-8 shadow-xl">
        <div class="border-b border-slate-100 dark:border-white/5 pb-5 mb-6">
          <h3 data-i18n="contact.formTitle" class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Kirim Pesan Langsung
          </h3>
          <p data-i18n="contact.formSub" class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            Isi formulir di bawah ini dan pesan akan langsung terkirim ke email saya.
          </p>
        </div>

        <form action="https://api.web3forms.com/submit" method="POST" class="space-y-5" id="contact-form">
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
          <input type="hidden" name="subject" value="Pesan Baru dari Portofolio Devan Regiana" />
          <input type="hidden" name="from_name" value="Devan Regiana Portfolio Contact" />

          <!-- Row 1: Name & Email -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="name" data-i18n="contact.formName" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Nama Lengkap Anda
              </label>
              <input
                type="text"
                name="name"
                id="name"
                required
                placeholder="Budi Santoso / Nama Anda"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-slate-900 dark:text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 dark:focus:ring-white transition-all"
              />
            </div>
            <div class="space-y-1.5">
              <label for="email" data-i18n="contact.formEmail" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Alamat Email Anda
              </label>
              <input
                type="email"
                name="email"
                id="email"
                required
                placeholder="budi@perusahaan.com"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-slate-900 dark:text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 dark:focus:ring-white transition-all"
              />
            </div>
          </div>

          <!-- Row 2: WhatsApp & Project Scope -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="phone" data-i18n="contact.formPhone" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Nomor WhatsApp / HP (Opsional)
              </label>
              <input
                type="text"
                name="phone"
                id="phone"
                placeholder="0812-xxxx-xxxx"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-slate-900 dark:text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 dark:focus:ring-white transition-all"
              />
            </div>
            <div class="space-y-1.5">
              <label for="role_inquiry" data-i18n="contact.formInquiryType" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Apa yang sedang Anda butuhkan?
              </label>
              <select
                name="role_inquiry"
                id="role_inquiry"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 dark:focus:ring-white transition-all cursor-pointer"
              >
                <option value="Pembuatan Website / Aplikasi Web Baru" data-i18n="contact.opt1">
                  Pembuatan Website / Aplikasi Web Baru
                </option>
                <option value="Toko Online / Sistem E-Commerce" data-i18n="contact.opt2">
                  Toko Online / Sistem E-Commerce
                </option>
                <option value="Dashboard Manajemen / Sistem Internal Kantor" data-i18n="contact.opt3">
                  Dashboard Manajemen / Sistem Internal Kantor
                </option>
                <option value="Optimasi Kecepatan & Pengaturan Server Cloud" data-i18n="contact.opt4">
                  Optimasi Kecepatan & Pengaturan Server Cloud
                </option>
                <option value="Tawaran Posisi Kerja Full-Time / Kontrak" data-i18n="contact.opt5">
                  Tawaran Posisi Kerja Full-Time / Kontrak
                </option>
              </select>
            </div>
          </div>

          <!-- Row 3: Message -->
          <div class="space-y-1.5">
            <label for="message" data-i18n="contact.formMsgLabel" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
              Deskripsi Kebutuhan / Pesan Anda
            </label>
            <textarea
              name="message"
              id="message"
              rows="4"
              required
              data-i18n-placeholder="contact.formMsgPlaceholder"
              placeholder="Ceritakan sedikit tentang ide proyek, target waktu, atau kebutuhan bisnis Anda..."
              class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-slate-900 dark:text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 dark:focus:ring-white transition-all resize-y"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3.5 px-6 rounded-2xl bg-slate-900 text-white dark:bg-white dark:text-slate-950 font-extrabold text-sm hover:opacity-90 transition-all shadow-lg active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer"
          >
            <Send class="w-4 h-4" />
            <span data-i18n="contact.btnSend">Kirim Pesan Sekarang</span>
          </button>

          <p data-i18n="contact.footerNote" class="text-xs text-slate-500 text-center">
            Bebas spam &bull; Informasi kontak Anda dijaga kerahasiaannya
          </p>
        </form>
      </div>

    </div>
  </div>
</section>

<!-- Zero-Dependency Copy Script with Visual Feedback -->
<script is:inline>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');
  const copyText = document.getElementById('copy-text');

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || 'dvnregiana007@gmail.com';
      try {
        await navigator.clipboard.writeText(email);
        if (copyIcon) copyIcon.classList.add('hidden');
        if (checkIcon) checkIcon.classList.remove('hidden');
        if (copyText) {
          const isId = document.documentElement.lang === 'id';
          copyText.textContent = isId ? 'Tersalin!' : 'Copied!';
        }
        setTimeout(() => {
          if (copyIcon) copyIcon.classList.remove('hidden');
          if (checkIcon) checkIcon.classList.add('hidden');
          if (copyText) {
            const isId = document.documentElement.lang === 'id';
            copyText.textContent = isId ? 'Salin' : 'Copy';
          }
        }, 2200);
      } catch (err) {
        console.error('Failed to copy email:', err);
      }
    });
  }
</script>
