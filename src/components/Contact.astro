---
import { Mail, Send, Shield, Clock, MapPin, Github, Linkedin, MessageCircle, Copy, Check, Briefcase, ExternalLink, Sparkles } from 'lucide-astro';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || "YOUR_ACCESS_KEY_HERE";
---

<section id="contact" class="py-20 border-t border-slate-200 dark:border-slate-850 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-md bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-mono text-cyan-600 dark:text-cyan-400 uppercase tracking-widest mb-3 shadow-sm">
        <MessageCircle class="w-3.5 h-3.5" />
        <span data-i18n="contact.badge">Direct Communication & Talent Inquiries</span>
      </div>
      <h2 data-i18n="contact.title" class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Initialize Engineering Collaboration
      </h2>
      <p data-i18n="contact.subtitle" class="mt-4 text-slate-600 dark:text-slate-400 max-w-2xl text-base leading-relaxed">
        Open for Full-Stack Software Engineer, Backend Developer, and DevOps/SRE roles across Indonesia (Jakarta, Bandung, Hybrid / Remote) & Global Remote.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Direct Talent & Engineering Channels (Left Column) -->
      <div class="lg:col-span-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0c121e]/80 backdrop-blur-md p-6 sm:p-8 space-y-6 shadow-sm">
        <div>
          <!-- Live Hiring Status Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-300 text-xs font-mono font-medium shadow-sm mb-3">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span data-i18n="contact.availBadge">Open for Opportunities • Immediate / Q4 2026</span>
          </div>
          <h3 data-i18n="contact.availTitle" class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">Direct Availability & Status</h3>
          <p data-i18n="contact.availSub" class="text-xs text-slate-500 dark:text-slate-400 mt-1">Actively open for Full-Time, Contract, and High-Impact Software Engineering Roles.</p>
        </div>

        <div class="space-y-3.5 text-sm font-mono text-slate-700 dark:text-slate-300">
          <!-- Direct Email Item with One-Click Copy -->
          <div class="p-3.5 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-slate-50 dark:bg-slate-900/50 flex items-start justify-between gap-3 group">
            <div class="flex items-start gap-3 min-w-0">
              <Mail class="w-4 h-4 text-violet-600 dark:text-violet-400 shrink-0 mt-0.5" />
              <div class="min-w-0">
                <span data-i18n="contact.emailLabel" class="text-xs text-slate-500 dark:text-slate-400 block">Direct Email Address</span>
                <a href="mailto:dvnregiana007@gmail.com" class="text-cyan-600 dark:text-cyan-400 font-semibold hover:underline break-all block text-xs sm:text-sm">
                  dvnregiana007@gmail.com
                </a>
              </div>
            </div>
            <button
              type="button"
              id="copy-email-btn"
              data-email="dvnregiana007@gmail.com"
              class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-[11px] text-slate-600 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-300 hover:border-cyan-500/30 transition-all cursor-pointer shrink-0 shadow-sm"
              title="Copy Email Address"
            >
              <Copy class="w-3.5 h-3.5" id="copy-icon" />
              <Check class="w-3.5 h-3.5 text-emerald-500 hidden" id="check-icon" />
              <span id="copy-text" data-i18n="contact.copyEmail">Copy</span>
            </button>
          </div>

          <!-- Fast-Track WhatsApp Item (Specially for Indonesian Tech Recruiters) -->
          <div class="p-3.5 rounded-xl border border-emerald-500/25 bg-emerald-50/40 dark:bg-emerald-950/20 flex items-start justify-between gap-3">
            <div class="flex items-start gap-3 min-w-0">
              <MessageCircle class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
              <div class="min-w-0">
                <span data-i18n="contact.whatsappLabel" class="text-xs text-slate-500 dark:text-slate-400 block">Fast-Track WhatsApp (HRD & Recruiter)</span>
                <span data-i18n="contact.whatsappVal" class="text-emerald-800 dark:text-emerald-300 font-semibold text-xs sm:text-sm block">
                  Start Direct Chat on WhatsApp
                </span>
              </div>
            </div>
            <a
              href="https://wa.me/?text=Halo%20Devan,%20saya%20melihat%20portfolio%20rekayasa%20Anda%20dan%20tertarik%20untuk%20mendiskusikan%20peluang%20rekayasa%20software..."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md border border-emerald-500/30 bg-emerald-500/10 text-[11px] text-emerald-700 dark:text-emerald-300 hover:bg-emerald-500/20 transition-all cursor-pointer shrink-0 font-medium shadow-sm"
            >
              <span data-i18n="contact.whatsappAction">Chat</span>
              <ExternalLink class="w-3 h-3" />
            </a>
          </div>

          <!-- Location & Working Flexibility -->
          <div class="p-3.5 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-slate-50 dark:bg-slate-900/50 flex items-start gap-3">
            <MapPin class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
            <div>
              <span data-i18n="contact.locLabel" class="text-xs text-slate-500 dark:text-slate-400 block">Location & Working Arrangement</span>
              <span data-i18n="contact.locVal" class="text-slate-800 dark:text-slate-200 font-semibold text-xs sm:text-sm leading-snug block">
                Indonesia (WIB / UTC+7) • Jakarta, Bandung, Remote (All Indonesia & Global WFH)
              </span>
            </div>
          </div>

          <!-- Response SLA Guarantee -->
          <div class="p-3.5 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-slate-50 dark:bg-slate-900/50 flex items-start gap-3">
            <Clock class="w-4 h-4 text-cyan-600 dark:text-cyan-400 shrink-0 mt-0.5" />
            <div>
              <span data-i18n="contact.slaLabel" class="text-xs text-slate-500 dark:text-slate-400 block">Response Time SLA</span>
              <span data-i18n="contact.slaVal" class="text-slate-800 dark:text-slate-200 font-semibold text-xs sm:text-sm block">
                &lt; 24 Hours Response Guarantee
              </span>
            </div>
          </div>
        </div>

        <!-- Target Roles & High-Demand Indonesian/Global Software Engineering Keywords -->
        <div class="pt-4 border-t border-slate-200 dark:border-slate-800/80">
          <div class="flex items-center justify-between mb-2.5">
            <span data-i18n="contact.targetRolesLabel" class="text-xs font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 font-semibold">
              Target Engineering Positions
            </span>
            <Briefcase class="w-3.5 h-3.5 text-slate-400" />
          </div>
          <div class="flex flex-wrap gap-1.5 mb-3.5">
            <span class="px-2.5 py-1 rounded-md text-[11px] font-mono bg-cyan-50 dark:bg-cyan-950/40 border border-cyan-500/30 text-cyan-700 dark:text-cyan-300 font-medium">
              Full-Stack Software Engineer
            </span>
            <span class="px-2.5 py-1 rounded-md text-[11px] font-mono bg-violet-50 dark:bg-violet-950/40 border border-violet-500/30 text-violet-700 dark:text-violet-300 font-medium">
              Backend & Microservices
            </span>
            <span class="px-2.5 py-1 rounded-md text-[11px] font-mono bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 font-medium">
              DevOps & Cloud SRE
            </span>
            <span class="px-2.5 py-1 rounded-md text-[11px] font-mono bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">
              Linux Server Hardening
            </span>
          </div>

          <div class="flex items-center justify-between mb-2">
            <span data-i18n="contact.skillsMatrixLabel" class="text-[11px] font-mono uppercase tracking-wider text-slate-400 dark:text-slate-500 font-medium">
              Production Stacks & Skills
            </span>
            <Sparkles class="w-3 h-3 text-cyan-500" />
          </div>
          <div class="flex flex-wrap gap-1.5">
            <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">Laravel</span>
            <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">Vue.js / React</span>
            <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">Python / FastAPI</span>
            <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">Docker</span>
            <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">Nginx</span>
            <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">PostgreSQL</span>
            <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">Redis Caching</span>
            <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">GitOps CI/CD</span>
          </div>
        </div>

        <!-- Professional Profiles -->
        <div class="pt-4 border-t border-slate-200 dark:border-slate-800/80">
          <span data-i18n="contact.profilesLabel" class="text-xs font-mono text-slate-500 dark:text-slate-400 uppercase tracking-wider block mb-3 font-semibold">
            Professional Engineering Profiles
          </span>
          <div class="flex flex-wrap items-center gap-3">
            <a href="https://github.com/devanscreate" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/80 text-xs text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors shadow-sm font-mono">
              <Github class="w-4 h-4" />
              <span>GitHub (@devanscreate)</span>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/80 text-xs text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors shadow-sm font-mono">
              <Linkedin class="w-4 h-4" />
              <span>LinkedIn Profile</span>
            </a>
          </div>
        </div>

        <div class="p-3 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-950/60 text-[11px] text-slate-600 dark:text-slate-400 font-mono flex items-center gap-2">
          <Shield class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
          <span data-i18n="contact.web3Note">Serverless static transmission powered by Web3Forms. Zero spam trackers. Direct inbox delivery to dvnregiana007@gmail.com.</span>
        </div>
      </div>

      <!-- Static Web3Forms Form (Right Column) -->
      <div class="lg:col-span-7 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0c121e]/90 backdrop-blur-md p-6 sm:p-8 shadow-xl">
        <div class="border-b border-slate-200 dark:border-slate-800 pb-4 mb-6">
          <h3 data-i18n="contact.formHeader" class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">
            Transmit Direct Message
          </h3>
          <p data-i18n="contact.formSub" class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            Inquiry details are securely transmitted directly to dvnregiana007@gmail.com.
          </p>
        </div>

        <form action="https://api.web3forms.com/submit" method="POST" class="space-y-5" id="contact-form">
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
          <input type="hidden" name="subject" value="New Engineering Opportunity Inquiry from devan.dev" />
          <input type="hidden" name="from_name" value="Devan Regiana Portfolio Contact" />

          <!-- Row 1: Name & Email -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="name" data-i18n="contact.formNameLabel" class="block text-xs font-mono text-slate-700 dark:text-slate-300">
                Your Name
              </label>
              <input
                type="text"
                name="name"
                id="name"
                required
                placeholder="Jane Doe / Recruiter Name"
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/80 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 font-sans"
              />
            </div>
            <div class="space-y-1.5">
              <label for="email" data-i18n="contact.formEmailLabel" class="block text-xs font-mono text-slate-700 dark:text-slate-300">
                Email Address
              </label>
              <input
                type="email"
                name="email"
                id="email"
                required
                placeholder="jane@company.com"
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/80 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 font-sans"
              />
            </div>
          </div>

          <!-- Row 2: Company & Inquiry Subject -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="company" data-i18n="contact.formCompanyLabel" class="block text-xs font-mono text-slate-700 dark:text-slate-300">
                Company / Organization (Optional)
              </label>
              <input
                type="text"
                name="company"
                id="company"
                placeholder="Startup / Tech Enterprise"
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/80 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 font-sans"
              />
            </div>
            <div class="space-y-1.5">
              <label for="role_inquiry" data-i18n="contact.formFocusLabel" class="block text-xs font-mono text-slate-700 dark:text-slate-300">
                Opportunity / Inquiry Subject
              </label>
              <select
                name="role_inquiry"
                id="role_inquiry"
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/80 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 font-sans cursor-pointer"
              >
                <option value="Full-Stack Software Engineer Role (Full-Time / Hybrid / Remote)" data-i18n="contact.opt1">
                  Full-Stack Software Engineer (Full-Time / Hybrid / Remote)
                </option>
                <option value="Backend Developer Role (Laravel / Python / APIs & Microservices)" data-i18n="contact.opt2">
                  Backend Developer (Laravel / Python / APIs & Microservices)
                </option>
                <option value="DevOps & Cloud Infrastructure Engineer (Linux / Docker / CI-CD)" data-i18n="contact.opt3">
                  DevOps & Cloud Infrastructure Engineer (Linux / Docker / CI-CD)
                </option>
                <option value="Project-Based / Contract System Architecture" data-i18n="contact.opt4">
                  Project-Based / Contract System Architecture
                </option>
                <option value="General Technical Discussion / Interview Invitation" data-i18n="contact.opt5">
                  General Technical Discussion / Interview Invitation
                </option>
              </select>
            </div>
          </div>

          <!-- Row 3: Message / Specifications -->
          <div class="space-y-1.5">
            <label for="message" data-i18n="contact.formMsgLabel" class="block text-xs font-mono text-slate-700 dark:text-slate-300">
              Message / Project Specifications
            </label>
            <textarea
              name="message"
              id="message"
              rows="5"
              required
              data-i18n-placeholder="contact.formMsgPlaceholder"
              placeholder="Tell me about your team, tech stack, system architecture, or open engineering role..."
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/80 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 font-sans resize-y"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-cyan-500 via-teal-500 to-emerald-500 text-slate-950 font-bold text-sm hover:from-cyan-400 hover:to-emerald-400 transition-all shadow-lg shadow-cyan-500/20 active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer"
          >
            <Send class="w-4 h-4" />
            <span data-i18n="contact.btnSend">Transmit Message</span>
          </button>

          <p data-i18n="contact.footerNote" class="text-[11px] font-mono text-slate-500 text-center">
            Zero telemetry trackers &bull; Spam-filtered via serverless captcha honeypot
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Zero-Dependency Copy Script with Visual Feedback -->
<script is:inline>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');
  const copyText = document.getElementById('copy-text');

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || 'dvnregiana007@gmail.com';
      try {
        await navigator.clipboard.writeText(email);
        if (copyIcon) copyIcon.classList.add('hidden');
        if (checkIcon) checkIcon.classList.remove('hidden');
        if (copyText) {
          const isId = document.documentElement.lang === 'id';
          copyText.textContent = isId ? 'Tersalin!' : 'Copied!';
        }
        setTimeout(() => {
          if (copyIcon) copyIcon.classList.remove('hidden');
          if (checkIcon) checkIcon.classList.add('hidden');
          if (copyText) {
            const isId = document.documentElement.lang === 'id';
            copyText.textContent = isId ? 'Salin' : 'Copy';
          }
        }, 2200);
      } catch (err) {
        console.error('Failed to copy email:', err);
      }
    });
  }
</script>
