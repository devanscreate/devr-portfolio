---
import { Mail, Send, Terminal, Shield, MessageSquare, Linkedin, Github, Clock, MapPin, CheckCircle } from 'lucide-astro';

// Free Web3Forms key can be set in .env as PUBLIC_WEB3FORMS_ACCESS_KEY or fallback
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || "YOUR_ACCESS_KEY_HERE";
---

<section id="contact" class="py-20 border-t border-slate-850 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-slate-900 border border-slate-800 text-xs font-mono text-cyan-400 uppercase tracking-widest mb-3">
        <Mail class="w-3.5 h-3.5" />
        <span>Direct Transmission Channel</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Initialize Contact
      </h2>
      <p class="mt-4 text-slate-400 max-w-2xl text-base leading-relaxed">
        Looking for a Lead Full-Stack Engineer, DevOps/SRE Architect, or cloud infrastructure consultant? Send a message directly to my inbox with zero intermediaries.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Direct Info & Availability SLA -->
      <div class="lg:col-span-5 rounded-2xl border border-slate-800 bg-[#0c121e]/70 backdrop-blur-md p-6 sm:p-8 space-y-6">
        <div>
          <h3 class="text-xl font-bold text-white tracking-tight">Direct Availability</h3>
          <p class="text-xs text-slate-400 mt-1">Available for full-time distributed roles & selective architectural audits.</p>
        </div>

        <div class="space-y-4 text-sm font-mono text-slate-300">
          <div class="p-3.5 rounded-xl border border-slate-800/80 bg-slate-900/50 flex items-start gap-3">
            <Clock class="w-4 h-4 text-cyan-400 shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-slate-400 block">Response Time SLA</span>
              <span class="text-slate-200 font-semibold">&lt; 24 Hours Response Guarantee</span>
            </div>
          </div>

          <div class="p-3.5 rounded-xl border border-slate-800/80 bg-slate-900/50 flex items-start gap-3">
            <MapPin class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-slate-400 block">Location & Flexibility</span>
              <span class="text-slate-200 font-semibold">Remote / Hybrid (Global Timezones)</span>
            </div>
          </div>

          <div class="p-3.5 rounded-xl border border-slate-800/80 bg-slate-900/50 flex items-start gap-3">
            <Mail class="w-4 h-4 text-violet-400 shrink-0 mt-0.5" />
            <div>
              <span class="text-xs text-slate-400 block">Direct Email</span>
              <a href="mailto:alex.vance.eng@example.com" class="text-cyan-400 hover:underline">
                alex.vance.eng@example.com
              </a>
            </div>
          </div>
        </div>

        <!-- Social Channels -->
        <div class="pt-4 border-t border-slate-850">
          <span class="text-xs font-mono text-slate-400 uppercase tracking-wider block mb-3">Professional Profiles</span>
          <div class="flex items-center gap-3">
            <a
              href="https://github.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-800 bg-slate-900/80 hover:bg-slate-800 text-xs text-slate-300 hover:text-white transition-colors"
            >
              <Github class="w-4 h-4" />
              <span>GitHub</span>
            </a>
            <a
              href="https://linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-800 bg-slate-900/80 hover:bg-slate-800 text-xs text-slate-300 hover:text-white transition-colors"
            >
              <Linkedin class="w-4 h-4" />
              <span>LinkedIn</span>
            </a>
          </div>
        </div>

        <!-- Web3Forms Zero Backend Note -->
        <div class="p-3 rounded-lg border border-slate-800 bg-slate-950/60 text-[11px] text-slate-400 font-mono flex items-center gap-2">
          <Shield class="w-4 h-4 text-emerald-400 shrink-0" />
          <span>Serverless form powered by Web3Forms. Zero database storage of contact logs.</span>
        </div>
      </div>

      <!-- Right Column: Static Web3Forms Form -->
      <div class="lg:col-span-7 rounded-2xl border border-slate-800 bg-[#0c121e]/90 backdrop-blur-md p-6 sm:p-8 shadow-xl">
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-5"
          id="contact-form"
        >
          <!-- Web3Forms API Key -->
          <input type="hidden" name="access_key" value={accessKey} />

          <!-- Anti-Spam Honeypot Field -->
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <!-- Optional Web3Forms Redirect or Subject -->
          <input type="hidden" name="subject" value="New Portfolio Inquiry from alex.dev" />
          <input type="hidden" name="from_name" value="Portfolio Contact Form" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Name Field -->
            <div class="space-y-1.5">
              <label for="name" class="block text-xs font-mono text-slate-300">
                Your Name <span class="text-rose-400">*</span>
              </label>
              <input
                type="text"
                name="name"
                id="name"
                required
                placeholder="Jane Doe"
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-800 bg-slate-900/80 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-all font-sans"
              />
            </div>

            <!-- Email Field -->
            <div class="space-y-1.5">
              <label for="email" class="block text-xs font-mono text-slate-300">
                Email Address <span class="text-rose-400">*</span>
              </label>
              <input
                type="email"
                name="email"
                id="email"
                required
                placeholder="jane@company.com"
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-800 bg-slate-900/80 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-all font-sans"
              />
            </div>
          </div>

          <!-- Opportunity / Role Focus -->
          <div class="space-y-1.5">
            <label for="role_inquiry" class="block text-xs font-mono text-slate-300">
              Inquiry Focus
            </label>
            <select
              name="role_inquiry"
              id="role_inquiry"
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-800 bg-slate-900/80 text-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-all font-sans"
            >
              <option value="Senior Full-Stack Developer Role">Senior Full-Stack Developer Opportunity</option>
              <option value="DevOps / SRE Architect Role">DevOps / SRE Architect Opportunity</option>
              <option value="Cloud Migration / IaC Consulting">Cloud Migration / Kubernetes Consulting</option>
              <option value="General Engineering Inquiry">General Engineering Inquiry</option>
            </select>
          </div>

          <!-- Message Field -->
          <div class="space-y-1.5">
            <label for="message" class="block text-xs font-mono text-slate-300">
              Message / Specification <span class="text-rose-400">*</span>
            </label>
            <textarea
              name="message"
              id="message"
              rows="5"
              required
              placeholder="Tell me about your tech stack, system challenges, or project requirements..."
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-800 bg-slate-900/80 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-all font-sans resize-y"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full py-3 px-6 rounded-xl bg-gradient-to-r from-cyan-500 via-teal-500 to-emerald-500 text-slate-950 font-bold text-sm hover:from-cyan-400 hover:to-emerald-400 transition-all shadow-lg shadow-cyan-500/20 active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer"
          >
            <Send class="w-4 h-4" />
            <span>Transmit Message</span>
          </button>

          <p class="text-[11px] font-mono text-slate-500 text-center">
            Zero telemetry trackers &bull; Spam-filtered via serverless captcha honeypot
          </p>
        </form>
      </div>

    </div>
  </div>
</section>
