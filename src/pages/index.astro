---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SkillsMatrix from '../components/SkillsMatrix.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProductionStandards from '../components/ProductionStandards.astro';
import Contact from '../components/Contact.astro';
import { getCollection } from 'astro:content';
import { Sparkles, Layers } from 'lucide-astro';

const rawProjects = await getCollection('projects');
const projects = rawProjects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const filterRoles = [
  { key: "All", i18nKey: "projects.filterAll", label: "Semua (6)" },
  { key: "Full-Stack", i18nKey: "projects.filterFullStack", label: "Full-Stack" },
  { key: "DevOps/SRE", i18nKey: "projects.filterDevOps", label: "Cloud & DevOps" },
  { key: "Hybrid", i18nKey: "projects.filterHybrid", label: "Fintech & API" },
];
---

<Layout
  title="Devan Regiana | Full-Stack Software Engineer & Solutions Architect"
  description="Portofolio digital Devan Regiana. 6 proyek unggulan: Toko online modern, dashboard perusahaan, reservasi real-time, verifikasi digital, dan server anti-down."
>
  <Hero />

  <!-- Selected Works (Exactly 6 Project Spaces) -->
  <section id="projects" class="py-20 sm:py-28 border-t border-slate-200 dark:border-white/10 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-16">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-widest mb-3 shadow-sm">
            <Layers class="w-3.5 h-3.5 text-cyan-500" />
            <span data-i18n="projects.badge">Koleksi Proyek Pilihan</span>
          </div>
          <h2 data-i18n="projects.title" class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
            Karya Digital & Sistem Nyata
          </h2>
          <p data-i18n="projects.subtitle" class="mt-3 text-slate-600 dark:text-slate-400 max-w-2xl text-sm sm:text-base leading-relaxed">
            6 proyek nyata yang dibangun untuk kecepatan tinggi, kemudahan penggunaan pengguna, dan dampak bisnis yang terbukti.
          </p>
        </div>

        <!-- Micro Zero-Bundle Role Filter Controls -->
        <div class="flex flex-wrap items-center gap-2 bg-slate-100/90 dark:bg-white/5 border border-slate-200 dark:border-white/10 p-1.5 rounded-2xl backdrop-blur-md shadow-sm" id="role-filters">
          {filterRoles.map((roleItem, idx) => (
            <button
              type="button"
              data-filter={roleItem.key}
              data-i18n={roleItem.i18nKey}
              class={`filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer ${
                idx === 0
                  ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-950 shadow-md'
                  : 'text-slate-600 dark:text-slate-400 hover:text-slate-950 dark:hover:text-white hover:bg-white/60 dark:hover:bg-white/10'
              }`}
            >
              {roleItem.label}
            </button>
          ))}
        </div>
      </div>

      <!-- 6 Clean Dedicated Spaces in a Responsive 3x2 Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="projects-grid">
        {projects.map((project, idx) => (
          <ProjectCard
            title={project.data.title}
            subtitle={project.data.subtitle}
            category={project.data.category}
            role={project.data.role}
            description={project.data.description}
            impact={project.data.impact}
            stack={project.data.stack}
            github={project.data.github}
            demo={project.data.demo}
            featured={project.data.featured}
            order={project.data.order ?? idx + 1}
            images={project.data.images}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Value & Capabilities Section -->
  <SkillsMatrix />
  <ProductionStandards />
  <Contact />

  <!-- Zero-overhead inline filtering logic -->
  <script is:inline>
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('#projects-grid > div');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        filterButtons.forEach((b) => {
          b.className = 'filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer text-slate-600 dark:text-slate-400 hover:text-slate-950 dark:hover:text-white hover:bg-white/60 dark:hover:bg-white/10';
        });
        btn.className = 'filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer bg-slate-900 text-white dark:bg-white dark:text-slate-950 shadow-md';

        projectCards.forEach((card) => {
          const cardRole = card.getAttribute('data-role');
          if (filter === 'All' || cardRole === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  </script>
</Layout>
