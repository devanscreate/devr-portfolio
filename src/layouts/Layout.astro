---
import '../styles/global.css';
import { Terminal, ShieldCheck, Github, Linkedin, Languages, Sun, Moon, ArrowUpRight } from 'lucide-astro';
import { translations } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Devan Regiana | Full-Stack Software Engineer & Solutions Architect",
  description = "Portofolio profesional Devan Regiana - Full-Stack Developer & Solutions Architect. Membangun aplikasi web modern, toko online cepat, sistem dashboard bisnis, dan server cloud anti-down.",
  image = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://devr-portfolio.pages.dev');
---

<!doctype html>
<html lang="id" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0b0e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-FOUC Theme Init Script -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 
          (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Devan Regiana, Jasa Pembuatan Website, Full-Stack Developer Indonesia, Pembuatan Web App, Toko Online, Dashboard Bisnis, DevOps, Cloud Server, Vue.js, Laravel, Python, Jakarta, Bandung, Remote" />
    <meta name="author" content="Devan Regiana" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Ultra-Fast Non-Blocking Google Fonts (Paints immediately in 0ms with local font fallback) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      />
    </noscript>

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Devan Regiana",
      "jobTitle": "Full-Stack Software Engineer & Solutions Architect",
      "url": canonicalURL,
      "knowsAbout": [
        "Web Application Development",
        "E-Commerce Solutions",
        "Business Operations Dashboards",
        "Vue.js, React, Tailwind CSS",
        "Laravel, Python FastAPI",
        "Cloud Hosting, Docker, Nginx"
      ]
    })} />
  </head>
  <body class="bg-[#fcfbf9] dark:bg-[#0a0b0e] text-slate-850 dark:text-slate-100 antialiased min-h-screen flex flex-col font-sans relative overflow-x-hidden transition-colors duration-200">
    
    <!-- Top Editorial Header (Clean & Minimalist like Reference Image) -->
    <header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[#fcfbf9]/90 dark:bg-[#0a0b0e]/90 border-b border-slate-200/70 dark:border-white/10 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- Brand / Identity (Geometric Capsule + Devanta Style) -->
        <a href="/" class="flex items-center gap-3.5 group">
          <div class="w-10 h-6 rounded-full bg-slate-900 dark:bg-white flex items-center justify-start px-1 group-hover:scale-105 transition-transform shadow-sm">
            <div class="w-3.5 h-3.5 rounded-full bg-white dark:bg-slate-950"></div>
          </div>
          <div class="flex flex-col leading-none">
            <span class="font-bold text-sm tracking-tight text-slate-900 dark:text-white uppercase font-sans">
              Devan
            </span>
            <span class="font-bold text-sm tracking-tight text-slate-500 dark:text-slate-400 uppercase font-sans mt-0.5">
              Regiana
            </span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-700 dark:text-slate-300">
          <a href="#projects" data-i18n="nav.projects" class="hover:text-slate-950 dark:hover:text-white transition-colors">Work</a>
          <a href="#skills" data-i18n="nav.skills" class="hover:text-slate-950 dark:hover:text-white transition-colors">Services</a>
          <a href="#standards" data-i18n="nav.standards" class="hover:text-slate-950 dark:hover:text-white transition-colors">Why Me</a>
          <a href="#contact" data-i18n="nav.contact" class="hover:text-slate-950 dark:hover:text-white transition-colors">Contact</a>
        </nav>

        <!-- Right Side Controls (Language, Theme, CTA) -->
        <div class="flex items-center gap-3">
          <!-- Dark / Light Theme Toggle -->
          <button
            type="button"
            id="theme-toggle"
            class="p-2 rounded-full border border-slate-200 dark:border-white/10 bg-white dark:bg-white/5 text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white transition-all cursor-pointer shadow-sm"
            title="Ganti Tema (Gelap / Terang)"
            aria-label="Toggle Dark/Light Mode"
          >
            <Moon id="icon-moon" class="w-4 h-4 text-cyan-400 hidden" />
            <Sun id="icon-sun" class="w-4 h-4 text-amber-500 hidden" />
          </button>

          <!-- Language Switcher ID/EN -->
          <div class="flex items-center rounded-full border border-slate-200 dark:border-white/10 bg-white dark:bg-white/5 p-1 text-xs font-mono shadow-sm" id="lang-switcher">
            <button
              type="button"
              id="lang-btn-id"
              class="px-2.5 py-1 rounded-full font-bold transition-all cursor-pointer bg-slate-900 text-white dark:bg-white dark:text-slate-950"
              aria-label="Bahasa Indonesia"
            >
              ID
            </button>
            <button
              type="button"
              id="lang-btn-en"
              class="px-2.5 py-1 rounded-full font-medium transition-all cursor-pointer text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
              aria-label="English"
            >
              EN
            </button>
          </div>

          <!-- Get In Touch Button / Link -->
          <a
            href="#contact"
            data-i18n="nav.hireMe"
            class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-950 hover:opacity-90 transition-all shadow-sm"
          >
            Hubungi Saya &rarr;
          </a>
        </div>
      </div>
    </header>

    <main class="flex-grow z-10 relative">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200 dark:border-white/10 bg-white dark:bg-[#07080a] z-10 relative mt-28 py-14 text-slate-600 dark:text-slate-400 text-sm transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-10 border-b border-slate-200 dark:border-white/10">
          <div>
            <div class="flex items-center gap-2 text-slate-900 dark:text-white font-bold text-base">
              <div class="w-6 h-3.5 rounded-full bg-slate-900 dark:bg-white flex items-center px-0.5">
                <div class="w-2.5 h-2.5 rounded-full bg-white dark:bg-slate-950"></div>
              </div>
              <span>Devan Regiana &bull; Full-Stack & Solutions</span>
            </div>
            <p data-i18n="footer.performance" class="text-slate-500 dark:text-slate-400 text-xs mt-1.5">
              Zero runtime bloat &bull; 100/100 Lighthouse performance &bull; Hosted on Cloudflare Edge
            </p>
          </div>
          <div class="flex items-center gap-3 bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 px-4 py-2 rounded-full text-xs shadow-sm">
            <span class="flex h-2.5 w-2.5 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
            </span>
            <span data-i18n="footer.operational" class="text-slate-800 dark:text-slate-200 font-medium">Terbuka untuk Proyek Baru & Posisi Full-Time</span>
          </div>
        </div>
        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-500 text-xs">
          <p>&copy; {new Date().getFullYear()} Devan Regiana. <span data-i18n="footer.license">Dibuat dengan dedikasi untuk produk digital berkualitas.</span></p>
          <div class="flex items-center gap-5 font-medium">
            <a href="#projects" class="hover:text-slate-900 dark:hover:text-white transition-colors">Work</a>
            <a href="#skills" class="hover:text-slate-900 dark:hover:text-white transition-colors">Services</a>
            <a href="#standards" class="hover:text-slate-900 dark:hover:text-white transition-colors">Why Me</a>
            <a href="#contact" class="hover:text-slate-900 dark:hover:text-white transition-colors">Contact</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Zero-Overhead Embedded Translations JSON -->
    <script id="i18n-dictionary" type="application/json" set:html={JSON.stringify(translations)} />

    <!-- Vanilla JS Theme & Language Engine -->
    <script is:inline>
      (function() {
        /* ================= THEME CONTROLLER ================= */
        const themeToggleBtn = document.getElementById('theme-toggle');
        const iconMoon = document.getElementById('icon-moon');
        const iconSun = document.getElementById('icon-sun');

        function updateThemeIcons(isDark) {
          if (isDark) {
            iconMoon?.classList.remove('hidden');
            iconSun?.classList.add('hidden');
          } else {
            iconSun?.classList.remove('hidden');
            iconMoon?.classList.add('hidden');
          }
        }

        const isInitiallyDark = document.documentElement.classList.contains('dark');
        updateThemeIcons(isInitiallyDark);

        themeToggleBtn?.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          updateThemeIcons(isDark);
        });

        /* ================= I18N CONTROLLER ================= */
        const dictEl = document.getElementById('i18n-dictionary');
        let dict = {};
        try {
          dict = JSON.parse(dictEl?.textContent || '{}');
        } catch(e) {
          console.error("Failed to parse i18n dictionary", e);
        }

        const btnId = document.getElementById('lang-btn-id');
        const btnEn = document.getElementById('lang-btn-en');

        function getNestedValue(obj, path) {
          return path.split('.').reduce((acc, part) => acc && acc[part], obj);
        }

        function applyLanguage(lang) {
          const trans = dict[lang];
          if (!trans) return;

          document.querySelectorAll('[data-i18n]').forEach((el) => {
            const key = el.getAttribute('data-i18n');
            const val = getNestedValue(trans, key);
            if (val) {
              el.textContent = val;
            }
          });

          document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
            const key = el.getAttribute('data-i18n-placeholder');
            const val = getNestedValue(trans, key);
            if (val) {
              el.setAttribute('placeholder', val);
            }
          });

          if (lang === 'id') {
            btnId?.classList.add('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-950');
            btnId?.classList.remove('text-slate-500', 'dark:text-slate-400');
            btnEn?.classList.remove('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-950');
            btnEn?.classList.add('text-slate-500', 'dark:text-slate-400');
          } else {
            btnEn?.classList.add('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-950');
            btnEn?.classList.remove('text-slate-500', 'dark:text-slate-400');
            btnId?.classList.remove('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-950');
            btnId?.classList.add('text-slate-500', 'dark:text-slate-400');
          }

          document.documentElement.lang = lang;
          localStorage.setItem('preferred-language', lang);
        }

        btnId?.addEventListener('click', () => applyLanguage('id'));
        btnEn?.addEventListener('click', () => applyLanguage('en'));

        const savedLang = localStorage.getItem('preferred-language') || 'id';
        applyLanguage(savedLang);
      })();
    </script>
  </body>
</html>
