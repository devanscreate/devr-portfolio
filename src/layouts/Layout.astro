---
import '../styles/global.css';
import { Terminal, ShieldCheck, Github, Linkedin, Languages, Sun, Moon } from 'lucide-astro';
import { translations } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Devan Regiana | DevOps Engineer & Full-Stack Developer",
  description = "Production portfolio of Devan Regiana - DevOps Engineer & Full-Stack Developer specializing in high-reliability infrastructure, decoupled socket bridges, Linux server hardening, and zero-downtime CI/CD automation.",
  image = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://devr-portfolio.31januaridd.workers.dev');
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#080c14" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-FOUC Theme Init Script (Runs before DOM render) -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 
          (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Fonts: Inter & JetBrains Mono with display=swap for Core Web Vitals -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Devan Regiana",
      "jobTitle": "DevOps Engineer & Full-Stack Developer",
      "url": canonicalURL,
      "knowsAbout": [
        "Linux Systems & Daemons",
        "TCP Sockets & WebSockets",
        "Python (FastAPI) & PHP (Laravel)",
        "Docker & Containerization",
        "Nginx Reverse Proxy & Load Balancing",
        "Continuous Integration & Continuous Delivery (CI/CD)"
      ]
    })} />
  </head>
  <body class="bg-slate-50 dark:bg-[#080c14] text-slate-800 dark:text-slate-200 antialiased min-h-screen flex flex-col font-sans relative overflow-x-hidden selection:bg-cyan-500 selection:text-slate-950 transition-colors duration-200">
    <div class="fixed inset-0 bg-grid-pattern opacity-10 dark:opacity-10 pointer-events-none z-0" style="background-size: 32px 32px;"></div>
    <div class="fixed top-[-10rem] left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-cyan-500/10 blur-[130px] rounded-full pointer-events-none z-0"></div>

    <header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-white/85 dark:bg-[#080c14]/85 border-b border-slate-200/80 dark:border-slate-800/80 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Brand / Identity -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-tr from-cyan-500/20 to-violet-500/20 border border-cyan-500/30 flex items-center justify-center text-cyan-500 dark:text-cyan-400 group-hover:border-cyan-400 transition-colors">
            <Terminal class="w-5 h-5" />
          </div>
          <div class="flex flex-col">
            <span class="font-mono font-bold text-sm text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
              devan.dev
              <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse" title="System Operational"></span>
            </span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 font-mono tracking-widest uppercase">DevOps &bull; Full-Stack</span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-slate-600 dark:text-slate-300">
          <a href="#projects" data-i18n="nav.projects" class="px-3.5 py-1.5 rounded-md hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-all">Projects</a>
          <a href="#skills" data-i18n="nav.skills" class="px-3.5 py-1.5 rounded-md hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-all">Skills Matrix</a>
          <a href="#standards" data-i18n="nav.standards" class="px-3.5 py-1.5 rounded-md hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-all">Production Standards</a>
          <a href="#contact" data-i18n="nav.contact" class="px-3.5 py-1.5 rounded-md hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-all">Contact</a>
        </nav>

        <!-- Right Side Controls (Theme, Language, Social, CTA) -->
        <div class="flex items-center gap-1.5 sm:gap-2.5">
          <!-- Dark / Light Theme Toggle -->
          <button
            type="button"
            id="theme-toggle"
            class="p-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 transition-all cursor-pointer shadow-sm"
            title="Ganti Tema (Gelap / Terang)"
            aria-label="Toggle Dark/Light Mode"
          >
            <Moon id="icon-moon" class="w-4 h-4 text-cyan-400 hidden" />
            <Sun id="icon-sun" class="w-4 h-4 text-amber-500 hidden" />
          </button>

          <!-- Lightweight ID/EN Language Switcher -->
          <div class="flex items-center rounded-lg border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 p-0.5 text-xs font-mono shadow-sm" id="lang-switcher">
            <div class="pl-1.5 pr-1 text-slate-400 hidden sm:flex items-center">
              <Languages class="w-3.5 h-3.5" />
            </div>
            <button
              type="button"
              id="lang-btn-id"
              class="px-2 py-1 rounded font-medium transition-colors cursor-pointer text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200"
              aria-label="Ganti Bahasa ke Indonesia"
            >
              ID
            </button>
            <span class="text-slate-300 dark:text-slate-600 text-[10px]">|</span>
            <button
              type="button"
              id="lang-btn-en"
              class="px-2 py-1 rounded font-medium transition-colors cursor-pointer bg-cyan-500/20 text-cyan-600 dark:text-cyan-300 border border-cyan-500/30"
              aria-label="Switch Language to English"
            >
              EN
            </button>
          </div>

          <a href="https://github.com/devanscreate" target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 transition-all shadow-sm" aria-label="GitHub Profile">
            <Github class="w-4 h-4" />
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 transition-all shadow-sm" aria-label="LinkedIn Profile">
            <Linkedin class="w-4 h-4" />
          </a>
          <a href="#contact" data-i18n="nav.hireMe" class="hidden sm:inline-flex items-center gap-1.5 text-xs font-mono px-3.5 py-2 rounded-lg bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 border border-cyan-500/30 hover:bg-cyan-500/20 transition-all font-medium">
            <span>Hubungi Saya</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </header>

    <main class="flex-grow z-10 relative">
      <slot />
    </main>

    <!-- Production Footer with Devan Regiana Branding -->
    <footer class="border-t border-slate-200 dark:border-slate-850 bg-slate-100 dark:bg-[#060910] z-10 relative mt-24 py-12 text-slate-600 dark:text-slate-400 text-xs font-mono transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-slate-200 dark:border-slate-800/60">
          <div>
            <div class="flex items-center gap-2 text-slate-800 dark:text-slate-200 font-semibold text-sm">
              <ShieldCheck class="w-4 h-4 text-emerald-500 dark:text-emerald-400" />
              <span data-i18n="footer.engineered">Engineered with Astro SSG & Tailwind CSS</span>
            </div>
            <p data-i18n="footer.performance" class="text-slate-500 dark:text-slate-400 text-[11px] mt-1">
              Zero runtime JS overhead &bull; 100/100 Lighthouse SLA target &bull; Hosted on Cloudflare Edge
            </p>
          </div>
          <div class="flex items-center gap-3 bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 px-3.5 py-1.5 rounded-full shadow-sm">
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span data-i18n="footer.operational" class="text-slate-700 dark:text-slate-300">All Systems Operational</span>
            <span class="text-slate-400 dark:text-slate-500">|</span>
            <span data-i18n="footer.uptime" class="text-emerald-600 dark:text-emerald-400 font-semibold">Production Ready</span>
          </div>
        </div>
        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-500 text-[11px]">
          <p>&copy; {new Date().getFullYear()} Devan Regiana. <span data-i18n="footer.license">Released under MIT License.</span></p>
          <div class="flex items-center gap-4">
            <a href="#projects" class="hover:text-slate-700 dark:hover:text-slate-300 transition-colors">Projects</a>
            <a href="#skills" class="hover:text-slate-700 dark:hover:text-slate-300 transition-colors">Skills</a>
            <a href="#standards" class="hover:text-slate-700 dark:hover:text-slate-300 transition-colors">Standards</a>
            <a href="#contact" class="hover:text-slate-700 dark:hover:text-slate-300 transition-colors">Contact</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Zero-Overhead Embedded Translations JSON (0 network request) -->
    <script id="i18n-dictionary" type="application/json" set:html={JSON.stringify(translations)} />

    <!-- Ultra-lightweight Vanilla JS Theme & Language Engine (< 1.5KB) -->
    <script is:inline>
      (function() {
        /* ================= THEME CONTROLLER ================= */
        const themeToggleBtn = document.getElementById('theme-toggle');
        const iconMoon = document.getElementById('icon-moon');
        const iconSun = document.getElementById('icon-sun');

        function updateThemeUI(isDark) {
          if (isDark) {
            document.documentElement.classList.add('dark');
            if (iconMoon) iconMoon.classList.remove('hidden');
            if (iconSun) iconSun.classList.add('hidden');
            localStorage.setItem('theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            if (iconMoon) iconMoon.classList.add('hidden');
            if (iconSun) iconSun.classList.remove('hidden');
            localStorage.setItem('theme', 'light');
          }
        }

        const isCurrentlyDark = document.documentElement.classList.contains('dark');
        updateThemeUI(isCurrentlyDark);

        if (themeToggleBtn) {
          themeToggleBtn.addEventListener('click', () => {
            const willBeDark = !document.documentElement.classList.contains('dark');
            updateThemeUI(willBeDark);
          });
        }

        /* ================= I18N CONTROLLER ================= */
        const dictEl = document.getElementById('i18n-dictionary');
        if (!dictEl) return;
        const dict = JSON.parse(dictEl.textContent);

        function getNested(obj, path) {
          return path.split('.').reduce((acc, part) => acc && acc[part], obj);
        }

        function applyLanguage(lang) {
          const t = dict[lang];
          if (!t) return;

          document.querySelectorAll('[data-i18n]').forEach((el) => {
            const key = el.getAttribute('data-i18n');
            const val = getNested(t, key);
            if (val !== undefined) {
              el.textContent = val;
            }
          });

          document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
            const key = el.getAttribute('data-i18n-placeholder');
            const val = getNested(t, key);
            if (val !== undefined) {
              el.setAttribute('placeholder', val);
            }
          });

          const btnId = document.getElementById('lang-btn-id');
          const btnEn = document.getElementById('lang-btn-en');
          const activeClass = 'px-2 py-1 rounded font-medium transition-colors cursor-pointer bg-cyan-500/20 text-cyan-600 dark:text-cyan-300 border border-cyan-500/30';
          const inactiveClass = 'px-2 py-1 rounded font-medium transition-colors cursor-pointer text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200';

          if (lang === 'id') {
            if (btnId) btnId.className = activeClass;
            if (btnEn) btnEn.className = inactiveClass;
            document.documentElement.lang = 'id';
          } else {
            if (btnId) btnId.className = inactiveClass;
            if (btnEn) btnEn.className = activeClass;
            document.documentElement.lang = 'en';
          }

          localStorage.setItem('portfolio_lang', lang);
        }

        const savedLang = localStorage.getItem('portfolio_lang') || 'en';
        applyLanguage(savedLang);

        const btnId = document.getElementById('lang-btn-id');
        const btnEn = document.getElementById('lang-btn-en');

        if (btnId) btnId.addEventListener('click', () => applyLanguage('id'));
        if (btnEn) btnEn.addEventListener('click', () => applyLanguage('en'));
      })();
    </script>
  </body>
</html>
